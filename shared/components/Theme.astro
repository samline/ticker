<script is:inline>
  ;(() => {
    let preference
    try {
      preference = localStorage.getItem('ticker-theme')
    } catch {}
    const theme =
      preference === 'light' || preference === 'dark'
        ? preference
        : matchMedia('(prefers-color-scheme: dark)').matches
          ? 'dark'
          : 'light'
    document.documentElement.dataset.theme = theme
    // Every theme-color meta follows the resolved theme, so a manual override or a
    // dark system with a light page never leaves the toolbar on the other scheme.
    const color = document.querySelector(`meta[name="theme-color"][data-scheme="${theme}"]`)
      ?.dataset.color
    if (color)
      for (const meta of document.querySelectorAll('meta[name="theme-color"]'))
        meta.setAttribute('content', color)
  })()
</script>

<script>
  const root = document.documentElement
  const system = matchMedia('(prefers-color-scheme: dark)')
  let manual = false
  try {
    manual = ['light', 'dark'].includes(localStorage.getItem('ticker-theme') ?? '')
  } catch {}
  function apply(theme: 'light' | 'dark') {
    root.dataset.theme = theme
    const color = document.querySelector<HTMLMetaElement>(
      `meta[name="theme-color"][data-scheme="${theme}"]`
    )?.dataset.color
    if (color)
      for (const meta of document.querySelectorAll('meta[name="theme-color"]'))
        meta.setAttribute('content', color)
    document.dispatchEvent(new CustomEvent('ticker:theme-change', { detail: theme }))
  }
  document.addEventListener('ticker:theme-request', event => {
    const theme = (event as CustomEvent<'light' | 'dark'>).detail
    if (theme !== 'light' && theme !== 'dark') return
    // Choosing the scheme the system already has undoes the override: drop the stored
    // value so the page follows the OS again. Only a different scheme is pinned.
    manual = theme !== (system.matches ? 'dark' : 'light')
    try {
      if (manual) localStorage.setItem('ticker-theme', theme)
      else localStorage.removeItem('ticker-theme')
    } catch {}
    apply(theme)
  })
  system.addEventListener('change', event => {
    if (!manual) apply(event.matches ? 'dark' : 'light')
  })
</script>
