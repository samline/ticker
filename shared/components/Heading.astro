---
import type { HTMLAttributes } from 'astro/types'
interface Props extends HTMLAttributes<'h1'> {
  context?: 'default' | 'closing' | 'faq'
  level?: 1 | 2 | 3 | 4 | 5 | 6
}
const { level = 2, context = 'default', class: className, ...attributes } = Astro.props
const Tag = `h${level}` as 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6'
---

<Tag
  data-context={context}
  {...attributes}
  class:list={[{ 'section-title': level === 2 }, className]}
>
  <slot />
</Tag>

<style>
  h1 :global(.serif),
  .section-title :global(.serif) {
    font-family: var(--font-serif);
    font-weight: 400;
    letter-spacing: -0.01em;
  }
  h1 {
    margin: 1.5625rem 0 0;
    font-size: clamp(2.75rem, 6.2vw, 5rem);
    font-weight: 500;
    line-height: 1.04;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }
  h1 :global(.serif) {
    color: var(--color-accent);
    font-style: italic;
    letter-spacing: -0.035em;
  }
  .section-title {
    font-size: clamp(2rem, 3.6vw, 3rem);
    line-height: 1.12;
    font-weight: 500;
    letter-spacing: -0.045em;
    text-wrap: balance;
    color: var(--color-text);
  }
  .section-title :global(.serif) {
    color: var(--palette-heading-accent);
  }
  .section-title[data-context='faq'] {
    font-size: clamp(2rem, 3.6vw, 2.65rem);
  }
  .section-title[data-context='closing'] {
    color: var(--palette-closing-title);
    max-width: 43.75rem;
    font-size: clamp(2.2rem, 4.7vw, 4rem);
  }
  .section-title[data-context='closing'] :global(.serif) {
    color: var(--palette-closing-title);
  }
  @media (width < 48rem) {
    h1 {
      font-size: clamp(2.5rem, 9vw, 4.1rem);
    }
  }
</style>
