{
  "name": "ticker-landing",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/include-docs.mjs && node scripts/check-site.mjs && node scripts/check-doc-links.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check": "node scripts/check-translations.mjs && astro check && npm run test",
    "format": "prettier --plugin prettier-plugin-astro --config ../.prettierrc.cjs --write . ../shared",
    "format:check": "prettier --plugin prettier-plugin-astro --config ../.prettierrc.cjs --check . ../shared",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@resvg/resvg-js": "^2.6.2",
    "@samline/drawer": "4.2.1",
    "@tailwindcss/vite": "4.3.0",
    "astro": "^7.3.8",
    "tailwindcss": "4.3.0"
  },
  "private": true,
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/compiler-rs": "0.5.1",
    "@playwright/test": "1.62.1",
    "axe-core": "^4.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^5.9.3",
    "vite": "8.3.4"
  }
}
