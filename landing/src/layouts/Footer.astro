---
import { getI18n } from '../i18n/utils'
import Box from '../components/Box.astro'
import Logo from '../components/Logo.astro'
const i18n = getI18n(Astro)
---

<footer class:list={['relative z-10 border-t-[0.0625rem] border-border-soft']}>
  <Box
    class:list={[
      'flex flex-col items-start justify-between gap-6 py-10 sm:flex-row sm:items-center',
    ]}
  >
    <Logo license={i18n.common.license} />

    <div class:list={['flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-text-muted']}>
      <a
        href="https://github.com/samline/ticker"
        target="_blank"
        rel="noopener noreferrer"
        class:list={['hover:text-text']}
      >
        {i18n.common.links.github}
        <span class:list={['sr-only']}>{i18n.common.externalLinkHint}</span>
      </a>
      <a
        href={`${import.meta.env.BASE_URL}docs/`}
        target="_blank"
        rel="noopener noreferrer"
        class:list={['hover:text-text']}
      >
        {i18n.common.links.docs}
        <span class:list={['sr-only']}>{i18n.common.externalLinkHint}</span>
      </a>
      <a
        href="https://www.npmjs.com/package/@samline/ticker"
        target="_blank"
        rel="noopener noreferrer"
        class:list={['hover:text-text']}
      >
        {i18n.common.links.npm}
        <span class:list={['sr-only']}>{i18n.common.externalLinkHint}</span>
      </a>
      <a
        href="https://github.com/samline/ticker/blob/main/LICENSE.md"
        target="_blank"
        rel="noopener noreferrer"
        class:list={['hover:text-text']}
      >
        {i18n.common.links.license}
        <span class:list={['sr-only']}>{i18n.common.externalLinkHint}</span>
      </a>
    </div>
  </Box>
  <Box class:list={['pb-10']}>
    <p class:list={['text-xs text-text-subtle']}>
      © <span id="year">{new Date().getFullYear()}</span> {i18n.navigation.footer.credit}
    </p>
  </Box>
</footer>
