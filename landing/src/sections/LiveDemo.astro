---
import Tabs from '../components/Tabs.astro'
import SpeedControl from '../components/SpeedControl.astro'
import TickerDemo from '../components/TickerDemo.astro'
import BrandLogo from '../components/BrandLogo.astro'

interface Props {
  id?: string
}
const { id = `demo-${crypto.randomUUID()}` } = Astro.props
---

<ticker-live-demo class:list={['demo-studio']} id={id}>
  <Tabs
    id="demo"
    variant="demo"
    label="Live demo content"
    class:list={['demo-tabs']}
    items={[
      { id: 'news', label: 'Announcements' },
      { id: 'logos', label: 'Brands' },
      { id: 'prices', label: 'Prices' },
    ]}
  >
    <div slot="heading" class:list={['studio-title']}>
      <span class:list={['status-dot']} aria-hidden="true"></span>
      <span>THE LIBRARY, LIVE</span>
    </div>

    <div class:list={['studio-panels']} data-panel-group="demo">
      <div class:list={['studio-panel']} data-panel="news">
        <div class:list={['specimen-heading']}>
          <span>01 / ANNOUNCEMENTS</span>
          <span>GOOD NEWS TRAVELS.</span>
        </div>
        <div class:list={['specimen']} data-slot="news">
          <TickerDemo id="ticker-news" kind="news" label="Latest announcements">
            <a href="#how" class:list={['font-medium']}>
              Release notes for v2.0.4
            </a>
            <span class:list={['sep']} aria-hidden="true"></span>
            <a href="#features">Built-in reduced-motion support</a>
            <span class:list={['sep']} aria-hidden="true"></span>
            <a href={`#${id}`} data-open-demo="prices">
              Try a sample price ticker
            </a>
            <span class:list={['sep']} aria-hidden="true"></span>
            <a href="#how">Get started with plain HTML</a>
            <span class:list={['sep']} aria-hidden="true"></span>
            <a href="https://github.com/samline/ticker">Explore the source on GitHub</a>
            <span class:list={['sep']} aria-hidden="true"></span>
            <a href="#faq">Read the accessibility FAQ</a>
            <span class:list={['sep']} aria-hidden="true"></span>
          </TickerDemo>
        </div>
      </div>
      <div class:list={['studio-panel']} data-panel="logos">
        <div class:list={['specimen-heading']}>
          <span>02 / BRAND STRIP</span>
          <span>SAMPLE LOGOS, NO ENDORSEMENTS.</span>
        </div>
        <div class:list={['specimen']} data-slot="logos">
          <TickerDemo
            id="ticker-logos"
            kind="logos"
            label="Sample brand logos; illustrative content, not endorsements"
          >
            <BrandLogo src="/assets/brands/vercel.svg" name="Vercel" />
            <BrandLogo src="/assets/brands/linear.svg" name="Linear" />
            <BrandLogo src="/assets/brands/stripe.svg" name="Stripe" />
            <BrandLogo src="/assets/brands/shopify.svg" name="Shopify" />
            <BrandLogo src="/assets/brands/figma.svg" name="Figma" />
            <BrandLogo src="/assets/brands/notion.svg" name="Notion" />
            <BrandLogo src="/assets/brands/github.svg" name="GitHub" />
            <BrandLogo src="/assets/brands/supabase.svg" name="Supabase" />
            <BrandLogo src="/assets/brands/raycast.svg" name="Raycast" />
            <BrandLogo src="/assets/brands/astro.svg" name="Astro" />
            <BrandLogo src="/assets/brands/vite.svg" name="Vite" />
            <BrandLogo src="/assets/brands/cloudflare.svg" name="Cloudflare" />
          </TickerDemo>
        </div>
      </div>
      <div class:list={['studio-panel']} data-panel="prices">
        <div class:list={['specimen-heading']}>
          <span>03 / MARKET TAPE</span>
          <span>ILLUSTRATIVE DATA.</span>
        </div>
        <div class:list={['specimen']} data-slot="prices">
          <TickerDemo id="ticker-prices" kind="prices" label="Sample market data">
            <span class:list={['font-semibold']}>BTC</span>
            <span class:list={['price']}>$94,210.40</span>
            <span class:list={['delta-up']}>+2.31%</span>
            <span class:list={['sep']} aria-hidden="true"></span>
            <span class:list={['font-semibold']}>ETH</span>
            <span class:list={['price']}>$3,540.18</span>
            <span class:list={['delta-up']}>+1.84%</span>
            <span class:list={['sep']} aria-hidden="true"></span>
            <span class:list={['font-semibold']}>SOL</span>
            <span class:list={['price']}>$182.07</span>
            <span class:list={['delta-down']}>−0.42%</span>
            <span class:list={['sep']} aria-hidden="true"></span>
            <span class:list={['font-semibold']}>AAPL</span>
            <span class:list={['price']}>$228.10</span>
            <span class:list={['delta-up']}>+0.62%</span>
            <span class:list={['sep']} aria-hidden="true"></span>
            <span class:list={['font-semibold']}>TSLA</span>
            <span class:list={['price']}>$341.92</span>
            <span class:list={['delta-down']}>−1.18%</span>
            <span class:list={['sep']} aria-hidden="true"></span>
            <span class:list={['font-semibold']}>NVDA</span>
            <span class:list={['price']}>$138.55</span>
            <span class:list={['delta-up']}>+3.07%</span>
            <span class:list={['sep']} aria-hidden="true"></span>
            <span class:list={['font-semibold']}>SPY</span>
            <span class:list={['price']}>$592.40</span>
            <span class:list={['delta-up']}>+0.22%</span>
            <span class:list={['sep']} aria-hidden="true"></span>
            <span class:list={['font-semibold']}>META</span>
            <span class:list={['price']}>$612.83</span>
            <span class:list={['delta-up']}>+0.91%</span>
            <span class:list={['sep']} aria-hidden="true"></span>
          </TickerDemo>
        </div>
      </div>
    </div>
  </Tabs>
  <div class:list={['studio-footer']}>
    <p>
      Hover to pause. <span>Make it your pace.</span>
    </p>
    <SpeedControl />
  </div>
</ticker-live-demo>

<script>
  class TickerLiveDemo extends HTMLElement {
    private lifecycle?: AbortController
    connectedCallback() {
      this.lifecycle?.abort()
      this.lifecycle = new AbortController()
      const { signal } = this.lifecycle
      let current = 'news'
      const active = () =>
        Array.from(this.querySelectorAll<HTMLElement>('ticker-demo')).find(
          demo => demo.dataset.kind === current && demo.closest('ticker-live-demo') === this
        )
      const sync = () => {
        const demo = active()
        this.querySelector('ticker-speed')?.dispatchEvent(
          new CustomEvent('speed:set', {
            detail: {
              duration: Number(demo?.dataset.duration ?? 38),
              enabled: demo?.dataset.initialized === 'true',
            },
          })
        )
        demo?.dispatchEvent(new Event('ticker:refresh'))
      }
      this.addEventListener(
        'tabs:change',
        event => {
          if ((event.target as Element).closest('ticker-live-demo') !== this) return
          const detail = (event as CustomEvent<{ group: string; tab: string }>).detail
          if (detail.group !== 'demo') return
          current = detail.tab
          sync()
        },
        { signal }
      )
      this.addEventListener('ticker:ready', sync, { signal })
      this.addEventListener(
        'speed:change',
        event => {
          if ((event.target as Element).closest('ticker-live-demo') !== this) return
          active()?.dispatchEvent(
            new CustomEvent('ticker:duration', { detail: (event as CustomEvent<number>).detail })
          )
        },
        { signal }
      )
      this.addEventListener(
        'click',
        event => {
          const link = (event.target as Element).closest<HTMLElement>('[data-open-demo]')
          if (!link || link.closest('ticker-live-demo') !== this) return
          const tab = Array.from(this.querySelectorAll<HTMLButtonElement>('[data-tab]')).find(
            tab => tab.dataset.tab === link.dataset.openDemo
          )
          tab?.click()
        },
        { signal }
      )
      Promise.all(
        ['ticker-tabs', 'ticker-demo', 'ticker-speed'].map(name => customElements.whenDefined(name))
      ).then(() => {
        if (!signal.aborted) sync()
      })
    }
    disconnectedCallback() {
      this.lifecycle?.abort()
    }
  }
  if (!customElements.get('ticker-live-demo'))
    customElements.define('ticker-live-demo', TickerLiveDemo)
</script>
<style>
  .studio-title {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.13em;
    line-height: 1.6;
  }
  .specimen-heading {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.13em;
    line-height: 1.6;
  }
  .demo-studio {
    max-width: 63rem;
    margin: 2.625rem auto 0;
    background: var(--palette-studio-surface);
    border: 0.0625rem solid var(--palette-studio-border);
    border-radius: 1.25rem;
    overflow: hidden;
    box-shadow: 0 1.5rem 4rem -2.25rem #0008;
    scroll-margin-top: 1.5rem;
  }
  .studio-title {
    display: flex;
    align-items: center;
    gap: 0.5625rem;
    color: var(--palette-studio-title);
  }
  .studio-panel {
    background: var(--palette-specimen-surface);
    padding: 1.5625rem 1.5rem 1rem;
    color: var(--palette-specimen-text);
  }
  .specimen-heading {
    display: flex;
    justify-content: space-between;
    gap: 1.25rem;
    color: var(--palette-specimen-label);
    margin-bottom: 1.25rem;
    font-size: 0.6rem;
  }
  .studio-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.25rem;
    padding: 1rem 1.5rem;
    color: var(--color-text-subtle);
    font-size: 0.72rem;
  }
  .studio-footer p span {
    color: var(--palette-studio-footer);
    margin-left: 0.25rem;
  }
  @media (width < 48rem) {
    .demo-studio {
      margin-top: 2.5rem;
    }
  }
  @media (width < 48rem) {
    .studio-panel {
      padding: 1.375rem 1.125rem 0.875rem;
    }
  }
  @media (width < 48rem) {
    .specimen-heading {
      font-size: 0.52rem;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
  }
  @media (width < 48rem) {
    .studio-footer {
      flex-direction: column;
      align-items: flex-start;
      padding: 1rem 1.125rem;
      gap: 0.875rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .studio-footer {
      display: none;
    }
  }
  ticker-live-demo {
    display: block;
  }
  .status-dot {
    display: inline-block;
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background: var(--color-accent);
    flex: none;
  }
</style>
