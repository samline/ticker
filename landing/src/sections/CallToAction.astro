---
import { docsHref } from '../lib/docs'
import RichText from '../components/RichText.astro'
import { getI18n } from '../i18n/utils'
import Reveal from '../components/Reveal.astro'
import Eyebrow from '../../../shared/components/Eyebrow.astro'
import Heading from '../../../shared/components/Heading.astro'
import Section from '../components/Section.astro'
import Box from '../../../shared/components/Box.astro'
import Button from '../../../shared/components/Button.astro'
const i18n = getI18n(Astro)
const t = i18n.sections.callToAction
const headingId = `section-heading-${crypto.randomUUID()}`
---

<Section
  aria-labelledby={headingId}
  spacing="none"
  class:list={['content-section closing-section']}
>
  <Box>
    <Reveal>
      <div class:list={['cta-card p-10 text-center sm:p-14 section-heading']} data-reveal="">
        <Eyebrow context="closing">{t.eyebrow}</Eyebrow>
        <Heading id={headingId} context="closing" class:list={['mx-auto mt-5 max-w-xl']}>
          <RichText parts={t.heading} />
        </Heading>
        <p class:list={['mx-auto mt-4 max-w-md text-text-muted']}>{t.description}</p>
        <div class:list={['mt-7 flex flex-col items-center justify-center gap-3 sm:flex-row']}>
          <Button context="closing" href="#how" class:list={['w-full sm:w-auto']} variant="primary">
            {i18n.common.buttons.getStarted}
            <svg
              aria-hidden="true"
              width="0.875rem"
              height="0.875rem"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="0.125rem"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M5 12h14M13 5l7 7-7 7"></path>
            </svg>
          </Button>
          <Button
            context="closing"
            href="https://github.com/samline/ticker"
            target="_blank"
            rel="noreferrer"
            class:list={['w-full sm:w-auto']}
            variant="secondary"
          >
            {i18n.common.buttons.starGithub}
          </Button>
        </div>
        <div class:list={['closing-docs']}>
          <p>{t.docs.description}</p>
          <a href={docsHref('overview')}>
            {t.docs.label}
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </Reveal>
  </Box>
</Section>

<style>
  .cta-card {
    position: relative;
    background:
      radial-gradient(circle at 50% 0%, rgba(183, 174, 210, 0.12), transparent 60%),
      var(--color-surface);
    border: 0.0625rem solid var(--color-border);
    border-radius: 1.75rem;
    overflow: hidden;
  }
  .cta-card {
    background: var(--palette-closing-surface);
    border: 0;
    border-radius: 1.25rem;
    padding: 4rem 1.5rem;
  }
  .cta-card > p {
    color: var(--palette-closing-text);
    font-size: 0.9rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .closing-docs a {
      transition: none;
    }
  }
</style>

<style>
  .closing-docs {
    display: grid;
    justify-items: center;
    gap: 0.625rem;
    margin-top: 2rem;
  }
  .closing-docs p {
    color: var(--palette-closing-text);
    font-size: 0.875rem;
    line-height: 1.7;
  }
  .closing-docs a {
    transition: color var(--duration-ui) var(--ease-ui);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--palette-closing-title);
    text-decoration: underline;
    text-underline-offset: 0.1875rem;
  }
  @media (hover: hover) {
    .closing-docs a:hover {
      color: var(--palette-closing-secondary);
    }
  }
  .closing-docs a:focus-visible {
    outline: 0.125rem solid var(--palette-closing-title);
    outline-offset: 0.25rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .closing-docs a {
      transition: none;
    }
  }
</style>
