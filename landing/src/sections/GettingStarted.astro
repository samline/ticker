---
import RichText from '../components/RichText.astro'
import { getI18n } from '../i18n/utils'
import Section from '../components/Section.astro'
import Box from '../components/Box.astro'
import SectionHeading from '../components/SectionHeading.astro'
import Tabs from '../components/Tabs.astro'
import CodeBlock from '../components/CodeBlock.astro'
import StepCard from '../components/StepCard.astro'
const i18n = getI18n(Astro)
const t = i18n.sections.gettingStarted
const headingId = `section-heading-${crypto.randomUUID()}`
---

<Section aria-labelledby={headingId} spacing="none" id="how" class:list={['content-section']}>
  <Box>
    <SectionHeading
      headingId={headingId}
      eyebrow={t.eyebrow}
      class:list={['mb-12 flex flex-col items-start gap-3']}
    >
      <RichText parts={t.heading} />
    </SectionHeading>

    <div class:list={['grid grid-cols-1 gap-6 lg:grid-cols-3']}>
      <StepCard number={1} title={t.steps.install}>
        <Tabs id="install" label={t.installLabel} class:list={['mt-4']} items={t.installTabs}>
          <div data-panel-group="install" class:list={['mt-4']}>
            <div data-panel="npm">
              <CodeBlock
                filename={t.examples.npm.filename}
                tokens={t.examples.npm.tokens}
                class:list={['']}
              />
            </div>
            <div data-panel="pnpm">
              <CodeBlock
                filename={t.examples.pnpm.filename}
                tokens={t.examples.pnpm.tokens}
                class:list={['']}
              />
            </div>
            <div data-panel="bun">
              <CodeBlock
                filename={t.examples.bun.filename}
                tokens={t.examples.bun.tokens}
                class:list={['']}
              />
            </div>
            <div data-panel="cdn">
              <CodeBlock
                filename={t.examples.cdn.filename}
                tokens={t.examples.cdn.tokens}
                class:list={['']}
              />
            </div>
          </div>
        </Tabs>
      </StepCard>

      <StepCard number={2} title={t.steps.markup}>
        <p class:list={['text-sm text-text-muted']}>{t.markupDescription}</p>
        <CodeBlock
          filename={t.examples.markup.filename}
          tokens={t.examples.markup.tokens}
          class:list={['mt-4']}
        />
      </StepCard>

      <StepCard number={3} title={t.steps.initialize}>
        <Tabs id="init" label={t.initLabel} class:list={['mt-4']} items={t.initTabs}>
          <div data-panel-group="init" class:list={['mt-4']}>
            <div data-panel="vanilla">
              <CodeBlock
                filename={t.examples.vanilla.filename}
                tokens={t.examples.vanilla.tokens}
                class:list={['']}
              />
            </div>
            <div data-panel="global">
              <CodeBlock
                filename={t.examples.global.filename}
                tokens={t.examples.global.tokens}
                class:list={['']}
              />
            </div>
          </div>
        </Tabs>
      </StepCard>
    </div>
  </Box>
</Section>
