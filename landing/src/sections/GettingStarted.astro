---
import TextLink from '../../../shared/components/TextLink.astro'
import RichText from '../components/RichText.astro'
import { docsHref } from '../lib/docs'
import { getI18n } from '../i18n/utils'
import Section from '../components/Section.astro'
import Box from '../../../shared/components/Box.astro'
import SectionHeading from '../components/SectionHeading.astro'
import Tabs from '../../../shared/components/Tabs.astro'
import CodeBlock from '../components/CodeBlock.astro'
import StepCard from '../components/StepCard.astro'
const i18n = getI18n(Astro)
const t = i18n.sections.gettingStarted
const headingId = `section-heading-${crypto.randomUUID()}`
---

<Section aria-labelledby={headingId} spacing="none" id="how" class:list={['content-section']}>
  <Box>
    <SectionHeading
      headingId={headingId}
      eyebrow={t.eyebrow}
      class:list={['mb-12 flex flex-col items-start gap-3']}
    >
      <RichText parts={t.heading} />
    </SectionHeading>

    <div class:list={['grid grid-cols-1 gap-6 lg:grid-cols-3']}>
      <StepCard number={1} title={t.steps.install}>
        <Tabs id="install" label={t.installLabel} class:list={['mt-4']} items={t.installTabs}>
          <div class:list={['mt-4']}>
            <div data-panel="npm">
              <CodeBlock filename={t.examples.npm.filename} tokens={t.examples.npm.tokens} />
            </div>
            <div data-panel="pnpm">
              <CodeBlock filename={t.examples.pnpm.filename} tokens={t.examples.pnpm.tokens} />
            </div>
            <div data-panel="bun">
              <CodeBlock filename={t.examples.bun.filename} tokens={t.examples.bun.tokens} />
            </div>
            <div data-panel="cdn">
              <CodeBlock filename={t.examples.cdn.filename} tokens={t.examples.cdn.tokens} />
            </div>
          </div>
        </Tabs>
      </StepCard>

      <StepCard number={2} title={t.steps.markup}>
        <p class:list={['text-sm text-text-muted']}>{t.markupDescription}</p>
        <CodeBlock
          filename={t.examples.markup.filename}
          tokens={t.examples.markup.tokens}
          class:list={['mt-4']}
        />
      </StepCard>

      <StepCard number={3} title={t.steps.initialize}>
        <Tabs id="init" label={t.initLabel} class:list={['mt-4']} items={t.initTabs}>
          <div class:list={['mt-4']}>
            <div data-panel="vanilla">
              <CodeBlock
                filename={t.examples.vanilla.filename}
                tokens={t.examples.vanilla.tokens}
              />
            </div>
            <div data-panel="global">
              <CodeBlock filename={t.examples.global.filename} tokens={t.examples.global.tokens} />
            </div>
          </div>
        </Tabs>
      </StepCard>
    </div>
    <div class:list={['setup-docs']}>
      <p>{t.docs.description}</p>
      <TextLink href={docsHref('options')}>{t.docs.label}</TextLink>
    </div>
  </Box>
</Section>
<style>
  .setup-docs {
    display: grid;
    gap: 0.75rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 0.0625rem solid var(--color-border);
  }
  p {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.7;
  }
</style>
