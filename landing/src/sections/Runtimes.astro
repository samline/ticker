---
import RichText from '../components/RichText.astro'
import { getI18n } from '../i18n/utils'
import Section from '../components/Section.astro'
import Box from '../../../shared/components/Box.astro'
import SectionHeading from '../components/SectionHeading.astro'
import RuntimeItem from '../components/RuntimeItem.astro'
const i18n = getI18n(Astro)
const t = i18n.sections.runtimes
const headingId = `section-heading-${crypto.randomUUID()}`
---

<Section
  aria-labelledby={headingId}
  spacing="none"
  class:list={['content-section runtime-section']}
>
  <Box>
    <SectionHeading
      headingId={headingId}
      context="runtime"
      eyebrow={t.eyebrow}
      class:list={['mb-10 flex flex-col items-start gap-3']}
    >
      <RichText parts={t.heading} />
      <Fragment slot="description">{t.description}</Fragment>
    </SectionHeading>

    <div class:list={['grid grid-cols-1 gap-3 md:grid-cols-2 lg:grid-cols-3 runtime-grid']}>
      <RuntimeItem label={t.items.main.label} entrypoint={t.items.main.entrypoint}>
        {t.items.main.description}
      </RuntimeItem>
      <RuntimeItem label={t.items.vanilla.label} entrypoint={t.items.vanilla.entrypoint}>
        {t.items.vanilla.description}
      </RuntimeItem>
      <RuntimeItem label={t.items.browser.label} entrypoint={t.items.browser.entrypoint}>
        {t.items.browser.description}
      </RuntimeItem>
      <RuntimeItem label={t.items.global.label} entrypoint={t.items.global.entrypoint}>
        {t.items.global.description}
      </RuntimeItem>
      <RuntimeItem label={t.items.core.label} entrypoint={t.items.core.entrypoint}>
        {t.items.core.description}
      </RuntimeItem>
      <RuntimeItem label={t.items.style.label} entrypoint={t.items.style.entrypoint}>
        {t.items.style.description}
      </RuntimeItem>
    </div>
  </Box>
</Section>

<style>
  .runtime-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 2.25rem;
    row-gap: 0;
  }
  @media (width < 48rem) {
    .runtime-grid {
      column-gap: 1.5rem;
    }
  }
  @media (width < 30rem) {
    .runtime-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
