---
import Heading from '../components/Heading.astro'
import Section from '../components/Section.astro'
import Box from '../components/Box.astro'
import Button from '../components/Button.astro'
import InstallCommand from '../components/InstallCommand.astro'
import Eyebrow from '../components/Eyebrow.astro'
import LiveDemo from './LiveDemo.astro'
---

<Section spacing="none" class:list={['hero-section']}>
  <Box liquid padding="none">
    <div class:list={['hero-intro']}>
      <Eyebrow status> SMALL LIBRARY. ENDLESS POSSIBILITIES.</Eyebrow>
      <Heading level={1}>
        A little motion.
        <br />
        <span class:list={['serif']}>A lot of possibility.</span>
      </Heading>
      <p class:list={['hero-description']}>
        Accessible ticker tapes for the open web.
        <br class:list={['desktop-break']} />
        Announcements, logos, and prices. Just your content, in motion.
      </p>
      <div class:list={['hero-actions']}>
        <Button context="hero" href="#how" class:list={['']} variant="primary">
          Get started <span aria-hidden="true">↗</span>
        </Button>
        <Button context="hero" href="#demo" class:list={['']} variant="secondary">
          Explore the demo <span aria-hidden="true">↓</span>
        </Button>
      </div>
      <InstallCommand />
      <p class:list={['hero-footnote']}>
        Zero dependencies <span aria-hidden="true">·</span> TypeScript ready
        <span aria-hidden="true">·</span> MIT licensed
      </p>
    </div>
    <LiveDemo id="demo" />
    <div class:list={['compatibility']}>
      <p>ONE SMALL SCRIPT. RIGHT AT HOME IN YOUR STACK.</p>
      <div>
        <span>JavaScript</span>
        <span>TypeScript</span>
        <span>React</span>
        <span>Vue</span>
        <span>Svelte</span>
        <span>Astro</span>
        <span>WordPress</span>
      </div>
    </div>
  </Box>
</Section>

<style>
  .hero-section {
    position: relative;
    padding: 3.5rem 1.5rem 0;
  }
  .hero-intro {
    max-width: 60rem;
    margin-inline: auto;
    text-align: center;
  }
  .compatibility > p {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.13em;
    line-height: 1.6;
  }
  .hero-description {
    margin: 1.625rem auto 0;
    max-width: 38.125rem;
    color: var(--color-text-muted);
    font-size: 1.05rem;
    line-height: 1.75;
    text-wrap: pretty;
  }
  .hero-actions {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1.875rem;
  }
  .hero-footnote {
    display: flex;
    justify-content: center;
    gap: 0.625rem;
    margin-top: 1.125rem;
    color: var(--color-text-subtle);
    font-size: 0.72rem;
  }
  .compatibility {
    max-width: 60rem;
    margin: 3rem auto 0;
    text-align: center;
  }
  .compatibility > p {
    color: var(--color-text-subtle);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
  }
  .compatibility > div {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    column-gap: 2.1875rem;
    row-gap: 1.25rem;
    margin-top: 1.5625rem;
    color: var(--palette-stack-text);
    font-size: 1.03rem;
    font-weight: 500;
    letter-spacing: -0.035em;
  }
  @media (width < 48rem) {
    .hero-section {
      padding-top: 3rem;
    }
  }
  @media (width < 48rem) {
    .hero-description {
      font-size: 0.9rem;
      max-width: 36ch;
    }
  }
  @media (width < 48rem) {
    .desktop-break {
      display: none;
    }
  }
  @media (width < 48rem) {
    .compatibility {
      margin-top: 2.25rem;
    }
  }
  @media (width < 48rem) {
    .compatibility > div {
      column-gap: 1.4375rem;
      font-size: 0.88rem;
    }
  }
  @media (width < 48rem) {
    .compatibility > p {
      max-width: 28ch;
      margin-inline: auto;
    }
  }
  @media (width < 30rem) {
    .hero-actions {
      gap: 0.375rem;
    }
  }
  @media (width < 30rem) {
    .hero-footnote {
      font-size: 0.58rem;
      gap: 0.4375rem;
    }
  }
</style>
