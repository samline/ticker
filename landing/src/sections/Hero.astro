---
import { getI18n } from '../i18n/utils'
import Heading from '../components/Heading.astro'
import Section from '../components/Section.astro'
import Box from '../components/Box.astro'
import Button from '../components/Button.astro'
import InstallCommand from '../components/InstallCommand.astro'
import Eyebrow from '../components/Eyebrow.astro'
import LiveDemo from './LiveDemo.astro'
const i18n = getI18n(Astro)
const t = i18n.sections.hero
const iconSeparator = ' '
const headingId = `section-heading-${crypto.randomUUID()}`
---

<Section aria-labelledby={headingId} spacing="none" class:list={['hero-section']}>
  <Box size="narrow" class:list={['hero-intro']}>
    <Eyebrow status> {t.kicker}</Eyebrow>
    <Heading id={headingId} level={1}>
      {t.title}
      <br />
      <span class:list={['serif']}>{t.titleAccent}</span>
    </Heading>
    <p class:list={['hero-description']}>
      {t.description}
      <br class:list={['desktop-break']} />
      {t.descriptionContinuation}
    </p>
    <div class:list={['hero-actions']}>
      <Button context="hero" href="#how" class:list={['']} variant="primary">
        {i18n.common.buttons.getStarted}
        {iconSeparator}
        <span aria-hidden="true">↗</span>
      </Button>
      <Button context="hero" href="#demo" class:list={['']} variant="secondary">
        {i18n.common.buttons.exploreDemo}
        {iconSeparator}
        <span aria-hidden="true">↓</span>
      </Button>
    </div>
    <InstallCommand />
    <p class:list={['hero-footnote']}>
      {t.footnotes[0]}
      <span aria-hidden="true">·</span>
      {t.footnotes[1]}
      <span aria-hidden="true">·</span>
      {t.footnotes[2]}
    </p>
  </Box>
  <Box size="medium">
    <LiveDemo id="demo" />
  </Box>
  <Box size="narrow" class:list={['compatibility']}>
    <p>{t.compatibilityLabel}</p>
    <div>
      {t.platforms.map(platform => (
        <>
          <span>{platform}</span>{' '}
        </>
      ))}
    </div>
  </Box>
</Section>

<style>
  .hero-section {
    position: relative;
    padding-top: 3.5rem;
  }
  .hero-intro {
    margin-inline: auto;
    text-align: center;
  }
  .compatibility > p {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.13em;
    line-height: 1.6;
  }
  .hero-description {
    margin: 1.625rem auto 0;
    color: var(--color-text-muted);
    font-size: 1.05rem;
    line-height: 1.75;
    text-wrap: pretty;
  }
  .hero-actions {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1.875rem;
  }
  .hero-footnote {
    display: flex;
    justify-content: center;
    gap: 0.625rem;
    margin-top: 1.125rem;
    color: var(--color-text-subtle);
    font-size: 0.72rem;
  }
  .compatibility {
    margin: 3rem auto 0;
    text-align: center;
  }
  .compatibility > p {
    color: var(--color-text-subtle);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
  }
  .compatibility > div {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    column-gap: 2.1875rem;
    row-gap: 1.25rem;
    margin-top: 1.5625rem;
    color: var(--palette-stack-text);
    font-size: 1.03rem;
    font-weight: 500;
    letter-spacing: -0.035em;
  }
  @media (width < 48rem) {
    .hero-section {
      padding-top: 3rem;
    }
  }
  @media (width < 48rem) {
    .hero-description {
      font-size: 0.9rem;
    }
  }
  @media (width < 48rem) {
    .desktop-break {
      display: none;
    }
  }
  @media (width < 48rem) {
    .compatibility {
      margin-top: 2.25rem;
    }
  }
  @media (width < 48rem) {
    .compatibility > div {
      column-gap: 1.4375rem;
      font-size: 0.88rem;
    }
  }
  @media (width < 48rem) {
    .compatibility > p {
      margin-inline: auto;
    }
  }
  @media (width < 30rem) {
    .hero-actions {
      gap: 0.625rem;
      flex-direction: column;
      margin-inline: auto;
    }
  }
  @media (width < 30rem) {
    .hero-footnote {
      font-size: 0.65rem;
      gap: 0.4375rem;
      flex-wrap: wrap;
    }
  }
</style>
