---
import Reveal from '../components/Reveal.astro'
import Section from '../components/Section.astro'
import Box from '../components/Box.astro'
import SectionHeading from '../components/SectionHeading.astro'
---

<Section spacing="none" id="compare" class:list={['content-section']}>
  <Box>
    <SectionHeading
      eyebrow="04 / The details that matter"
      class:list={['mb-10 flex flex-col items-start gap-3']}
    >
      Small footprint.
      <br />
      <span class:list={['serif italic']}>A considered foundation.</span>
      <Fragment slot="description">
        See what the library handles and what your integration controls.
      </Fragment>
    </SectionHeading>

    <Reveal>
      <div
        class:list={['overflow-x-auto']}
        data-reveal=""
        tabindex="0"
        role="region"
        aria-label="Ticker capabilities table"
      >
        <table class:list={['compare']}>
          <caption class:list={['sr-only']}>
            Ticker capabilities and integration responsibilities
          </caption>
          <thead>
            <tr>
              <th scope="col">Capability</th>
              <th scope="col" class:list={['here']}>
                @samline/ticker
              </th>
              <th scope="col">Your integration</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">Framework dependencies</th>
              <td class:list={['center']}>None</td>
              <td>Use the DOM API from your framework lifecycle.</td>
            </tr>
            <tr>
              <th scope="row">Visual clones</th>
              <td class:list={['center']}>Hidden from assistive technology and keyboard focus</td>
              <td>Keep the original content meaningful and accessible.</td>
            </tr>
            <tr>
              <th scope="row">Playback</th>
              <td class:list={['center']}>Pauses off-screen and in hidden documents</td>
              <td>Offer a pause control for continuous motion.</td>
            </tr>
            <tr>
              <th scope="row">Reduced motion</th>
              <td class:list={['center']}>Respects the system preference</td>
              <td>Keep static content readable and reachable.</td>
            </tr>
            <tr>
              <th scope="row">Layout changes</th>
              <td class:list={['center']}>Remeasures on resize</td>
              <td>Call refresh() after editing content or loading fonts.</td>
            </tr>
            <tr>
              <th scope="row">Distribution</th>
              <td class:list={['center']}>ESM, CommonJS, browser global, and CSS</td>
              <td>Load the stylesheet alongside the API.</td>
            </tr>
            <tr>
              <th scope="row">Licensing</th>
              <td class:list={['center']}>MIT</td>
              <td>Retain the license when redistributing.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </Reveal>
  </Box>
</Section>

<style>
  .compare {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }
  .compare thead th {
    text-align: center;
    padding: 1.25rem 0.75rem;
    font-weight: 500;
    color: var(--color-text-muted);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    border-bottom: 0.0625rem solid var(--color-border);
  }
  .compare thead th:first-child {
    text-align: left;
    color: var(--color-text-subtle);
  }
  .compare thead th.here {
    position: relative;
    color: var(--color-text);
  }
  .compare thead th.here::before {
    content: '';
    position: absolute;
    inset: 0.5rem 1.25rem;
    border: 0.0625rem solid var(--color-accent);
    border-radius: 1rem;
    pointer-events: none;
  }
  .compare tbody th {
    padding: 1.1rem 0.75rem;
    text-align: center;
    border-bottom: 0.0625rem solid var(--color-border-soft);
    color: var(--color-text-muted);
  }
  .compare tbody td {
    padding: 1.1rem 0.75rem;
    text-align: center;
    border-bottom: 0.0625rem solid var(--color-border-soft);
    color: var(--color-text-muted);
  }
  .compare tbody th {
    font-weight: 500;
    text-align: left;
    color: var(--color-text);
  }
  .compare tbody td.center {
    background: linear-gradient(180deg, rgba(183, 174, 210, 0.04), transparent);
  }
  .compare tbody tr:last-child th {
    border-bottom: 0;
  }
  .compare tbody tr:last-child td {
    border-bottom: 0;
  }
  .compare {
    min-width: 40rem;
  }
  .compare {
    font-size: 0.875rem;
  }
  .compare thead th {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0;
  }
  .compare tbody td {
    padding-block: 1.375rem;
    line-height: 1.6;
  }
  .compare tbody th {
    padding-block: 1.375rem;
    line-height: 1.6;
  }
  .compare thead th.here::before {
    border-color: var(--palette-compare-border);
    border-radius: 0.625rem;
  }
  .compare tbody td.center {
    background: var(--palette-compare-surface);
    color: var(--palette-compare-text);
  }
  :focus-visible {
    outline: 0.125rem solid var(--color-accent);
    outline-offset: 0.25rem;
  }
  @media (prefers-reduced-motion: reduce) {
    :where(a, button, summary) {
      transition: none;
    }
  }
</style>
