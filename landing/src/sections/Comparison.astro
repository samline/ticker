---
import { getI18n } from '../i18n/utils'
import Reveal from '../components/Reveal.astro'
import Section from '../components/Section.astro'
import Box from '../components/Box.astro'
import SectionHeading from '../components/SectionHeading.astro'
const i18n = getI18n(Astro)
const t = i18n.sections.comparison
const headingId = `section-heading-${crypto.randomUUID()}`
---

<Section aria-labelledby={headingId} spacing="none" id="compare" class:list={['content-section']}>
  <Box>
    <SectionHeading
      headingId={headingId}
      eyebrow={t.eyebrow}
      class:list={['mb-10 flex flex-col items-start gap-3']}
    >
      {t.title}
      <br />
      <span class:list={['serif italic']}>{t.titleAccent}</span>
      <Fragment slot="description">{t.description}</Fragment>
    </SectionHeading>

    <Reveal>
      <div
        class:list={['overflow-x-auto']}
        data-reveal=""
        tabindex="0"
        role="region"
        aria-label={t.ariaLabel}
      >
        <table class:list={['compare']}>
          <caption class:list={['sr-only']}>{t.caption}</caption>
          <thead>
            <tr>
              <th scope="col">{t.headers.capability}</th>
              <th scope="col" class:list={['here']}>
                {i18n.common.packageName}
              </th>
              <th scope="col">{t.headers.integration}</th>
            </tr>
          </thead>
          <tbody>
            {Object.values(t.rows).map(row => (
              <tr>
                <th scope="row">{row.capability}</th>
                <td class:list={['center']}>{row.library}</td>
                <td>{row.integration}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </Reveal>
  </Box>
</Section>

<style>
  .compare {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }
  .compare thead th {
    text-align: center;
    padding: 1.25rem 0.75rem;
    font-weight: 500;
    color: var(--color-text-muted);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    border-bottom: 0.0625rem solid var(--color-border);
  }
  .compare thead th:first-child {
    text-align: left;
    color: var(--color-text-subtle);
  }
  .compare thead th.here {
    position: relative;
    color: var(--color-text);
  }
  .compare thead th.here::before {
    content: '';
    position: absolute;
    inset: 0.5rem 1.25rem;
    border: 0.0625rem solid var(--color-accent);
    border-radius: 1rem;
    pointer-events: none;
  }
  .compare tbody th {
    padding: 1.1rem 0.75rem;
    text-align: center;
    border-bottom: 0.0625rem solid var(--color-border-soft);
    color: var(--color-text-muted);
  }
  .compare tbody td {
    padding: 1.1rem 0.75rem;
    text-align: center;
    border-bottom: 0.0625rem solid var(--color-border-soft);
    color: var(--color-text-muted);
  }
  .compare tbody th {
    font-weight: 500;
    text-align: left;
    color: var(--color-text);
  }
  .compare tbody td.center {
    background: linear-gradient(180deg, rgba(183, 174, 210, 0.04), transparent);
  }
  .compare tbody tr:last-child th {
    border-bottom: 0;
  }
  .compare tbody tr:last-child td {
    border-bottom: 0;
  }
  .compare {
    min-width: 40rem;
  }
  .compare {
    font-size: 0.875rem;
  }
  .compare thead th {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0;
  }
  .compare tbody td {
    padding-block: 1.375rem;
    line-height: 1.6;
  }
  .compare tbody th {
    padding-block: 1.375rem;
    line-height: 1.6;
  }
  .compare thead th.here::before {
    border-color: var(--palette-compare-border);
    border-radius: 0.625rem;
  }
  .compare tbody td.center {
    background: var(--palette-compare-surface);
    color: var(--palette-compare-text);
  }
  :focus-visible {
    outline: 0.125rem solid var(--color-accent);
    outline-offset: 0.25rem;
  }
  @media (prefers-reduced-motion: reduce) {
    :where(a, button, summary) {
      transition: none;
    }
  }
</style>
