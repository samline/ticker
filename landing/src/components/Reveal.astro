<ticker-reveal>
  <slot />
</ticker-reveal>
<script>
  class TickerReveal extends HTMLElement {
    private observer?: IntersectionObserver
    connectedCallback() {
      this.observer?.disconnect()
      const target = this.firstElementChild
      if (
        !target ||
        !('IntersectionObserver' in window) ||
        matchMedia('(prefers-reduced-motion: reduce)').matches ||
        target.getBoundingClientRect().top < innerHeight
      )
        return
      this.dataset.pending = 'true'
      this.observer = new IntersectionObserver(
        entries => {
          if (entries.some(entry => entry.isIntersecting)) {
            delete this.dataset.pending
            this.observer?.disconnect()
          }
        },
        { threshold: 0, rootMargin: '0px 0px 64px 0px' }
      )
      this.observer.observe(target)
    }
    disconnectedCallback() {
      this.observer?.disconnect()
      delete this.dataset.pending
    }
  }
  if (!customElements.get('ticker-reveal')) customElements.define('ticker-reveal', TickerReveal)
</script>
<style>
  ticker-reveal {
    display: block;
    min-width: 0;
    transition:
      opacity var(--duration-reveal) var(--ease-ui),
      transform var(--duration-reveal) var(--ease-ui);
  }
  ticker-reveal > :global(*) {
    height: 100%;
  }
  ticker-reveal[data-pending] {
    opacity: 0;
    transform: translateY(0.75rem);
  }
  @media (prefers-reduced-motion: reduce) {
    ticker-reveal {
      transition: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
