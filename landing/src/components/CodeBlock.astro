---
interface Props {
  filename: string
  class?: string
}
const { filename, class: className } = Astro.props
const content = (await Astro.slots.render('default')).trim()
---

<div class:list={['code-block', className]}>
  <header>
    <span class:list={['dot']}></span> {filename}
  </header>
  <pre><code set:html={content} /></pre>
</div>

<style>
  .code-block {
    background: var(--palette-on-accent);
    border: 0.0625rem solid var(--color-border);
    border-radius: 1rem;
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: 0.825rem;
    line-height: 1.7;
  }
  .code-block header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1rem;
    border-bottom: 0.0625rem solid var(--color-border-soft);
    font-size: 0.7rem;
    color: var(--color-text-subtle);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .code-block header .dot {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 624.9375rem;
    background: var(--color-border);
  }
  .code-block pre {
    margin: 0;
    padding: 1rem 1.25rem 1.25rem;
    overflow-x: auto;
    color: var(--palette-code-text);
  }
  .code-block pre code {
    font-family: inherit;
  }

  .code-block :global(.tok-com) {
    color: var(--palette-syntax-muted);
    font-style: italic;
  }
  .code-block :global(.tok-key) {
    color: var(--palette-lavender);
  }
  .code-block :global(.tok-str) {
    color: var(--palette-syntax-string);
  }
  .code-block :global(.tok-fn) {
    color: var(--palette-syntax-tag);
  }
  .code-block :global(.tok-num) {
    color: var(--palette-syntax-attribute);
  }
  .code-block :global(.tok-tag) {
    color: var(--palette-syntax-number);
  }
  .code-block :global(.tok-attr) {
    color: var(--palette-syntax-function);
  }
  .code-block :global(.tok-pun) {
    color: var(--palette-syntax-muted);
  }
  .code-block {
    background: var(--palette-code-surface);
    border-color: var(--palette-code-border);
    border-radius: 0.625rem;
    font-size: 0.73rem;
  }
  .code-block header {
    color: var(--palette-code-header);
    font-size: 0.58rem;
  }
  .code-block pre {
    padding: 1rem;
  }
</style>
