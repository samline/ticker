---
import { getI18n, getLocale } from '../i18n/utils'
import { serializeJsonLd } from '../../../shared/lib/serialize'
import packageInfo from '../../../package.json'

const i18n = getI18n(Astro)
const locale = getLocale(Astro.currentLocale)
interface Props {
  title?: string
  description?: string
  keywords?: readonly string[]
}
const {
  title = i18n.seo.title,
  description = i18n.seo.description,
  keywords = i18n.seo.keywords,
} = Astro.props
const canonical = Astro.site
  ? new URL(
      Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`,
      Astro.site
    ).href
  : undefined
const home = Astro.site?.href
const indexable = import.meta.env.PROD && !!canonical
const image = canonical ? new URL('social.png', home).href : undefined
const icon = `${import.meta.env.BASE_URL}favicon.svg`
const repository = packageInfo.repository.url.replace(/^git\+/, '').replace(/\.git$/, '')
const software = {
  '@type': 'SoftwareSourceCode',
  '@id': canonical ? `${home}#software` : undefined,
  name: i18n.common.packageName,
  description: i18n.seo.description,
  version: i18n.common.version,
  codeRepository: repository,
  programmingLanguage: i18n.seo.software.languages,
  runtimePlatform: i18n.seo.software.platform,
  license: `${repository}/blob/main/LICENSE.md`,
  author: { '@type': 'Person', name: i18n.common.author },
  url: home,
  inLanguage: locale,
}
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': canonical ? `${home}#website` : undefined,
      name: i18n.common.packageName,
      url: home,
      inLanguage: locale,
    },
    {
      '@type': 'WebPage',
      '@id': canonical ? `${canonical}#webpage` : undefined,
      url: canonical,
      name: title,
      description,
      inLanguage: locale,
      isPartOf: canonical ? { '@id': `${home}#website` } : undefined,
      mainEntity: canonical ? { '@id': `${home}#software` } : software,
      primaryImageOfPage: image
        ? { '@type': 'ImageObject', url: image, width: 1200, height: 630 }
        : undefined,
    },
    software,
  ],
}
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="keywords" content={keywords.join(', ')} />
<meta name="author" content={i18n.common.author} />
<meta
  name="robots"
  content={
    indexable
      ? 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'
      : 'noindex, follow'
  }
/>
<meta name="referrer" content="strict-origin-when-cross-origin" />
<meta name="color-scheme" content="light dark" />
<meta name="theme-color" content="#1d1c23" />
{canonical && <link rel="canonical" href={canonical} />}
<link rel="icon" type="image/svg+xml" href={icon} />
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content={i18n.common.packageName} />
<meta property="og:locale" content={i18n.seo.social.locale} />
{canonical && <meta property="og:url" content={canonical} />}
{image && (
  <>
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={i18n.seo.social.imageAlt} />
    {image.startsWith('https:') && <meta property="og:image:secure_url" content={image} />}
  </>
)}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{image && (
  <>
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={i18n.seo.social.imageAlt} />
  </>
)}
<script type="application/ld+json" is:inline set:html={serializeJsonLd(schema)} />
