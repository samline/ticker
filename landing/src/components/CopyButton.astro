---
import { getI18n } from '../i18n/utils'
interface Props {
  text: string
  ariaLabel: string
  variant?: 'code' | 'command'
}
const { text, ariaLabel, variant = 'code' } = Astro.props
const t = getI18n(Astro).controls.copy
---

<ticker-copy
  class:list={['copy-control']}
  data-copy-text={text}
  data-label={t.label}
  data-copied-label={t.copiedLabel}
  data-success={t.success}
  data-fallback={t.fallback}
  data-variant={variant}
>
  <button type="button" aria-label={ariaLabel} hidden>
    <span data-copy-label="">{t.label}</span>
    <span aria-hidden="true">⧉</span>
  </button>
  <span
    class:list={['sr-only']}
    role="status"
    aria-live="polite"
    aria-atomic="true"
    data-copy-status=""
  ></span>
</ticker-copy>
<script>
  class TickerCopy extends HTMLElement {
    private lifecycle?: AbortController
    private feedbackTimer?: ReturnType<typeof setTimeout>
    connectedCallback() {
      this.lifecycle?.abort()
      this.lifecycle = new AbortController()
      const { signal } = this.lifecycle
      const button = this.querySelector<HTMLButtonElement>('button')
      const label = this.querySelector<HTMLElement>('[data-copy-label]')
      const status = this.querySelector<HTMLElement>('[data-copy-status]')
      if (!button || !label || !status) return
      label.textContent = this.dataset.label ?? ''
      button.hidden = false
      button.addEventListener(
        'click',
        async () => {
          clearTimeout(this.feedbackTimer)
          label.textContent = this.dataset.label ?? ''
          status.textContent = ''
          try {
            await navigator.clipboard.writeText(this.dataset.copyText ?? '')
            if (signal.aborted) return
            label.textContent = this.dataset.copiedLabel ?? ''
            status.textContent = this.dataset.success ?? ''
            this.feedbackTimer = setTimeout(() => {
              if (!signal.aborted) label.textContent = this.dataset.label ?? ''
            }, 2000)
          } catch {
            if (signal.aborted) return
            const code = this.closest('[data-copy-source]')?.querySelector('code')
            if (!code) return
            const range = document.createRange()
            range.selectNodeContents(code)
            const selection = window.getSelection()
            selection?.removeAllRanges()
            selection?.addRange(range)
            status.textContent = this.dataset.fallback ?? ''
          }
        },
        { signal }
      )
    }
    disconnectedCallback() {
      this.lifecycle?.abort()
      clearTimeout(this.feedbackTimer)
    }
  }
  if (!customElements.get('ticker-copy')) customElements.define('ticker-copy', TickerCopy)
</script>
<style>
  .copy-control {
    display: inline-flex;
    flex-shrink: 0;
  }
  button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    min-height: 2rem;
    min-width: 4.5rem;
    padding: 0.375rem 0.625rem;
    color: var(--color-text-muted);
    background: transparent;
    border: 0.0625rem solid var(--color-border);
    border-radius: 0.375rem;
    font-family: var(--font-sans);
    font-size: 0.7rem;
    line-height: 1.25;
    cursor: pointer;
    transition:
      color var(--duration-ui) var(--ease-ui),
      background-color var(--duration-ui) var(--ease-ui),
      border-color var(--duration-ui) var(--ease-ui);
  }
  button[hidden] {
    display: none;
  }
  @media (hover: hover) {
    button:hover {
      color: var(--color-accent);
      background: var(--color-accent-soft);
      border-color: var(--palette-border-hover);
    }
  }
  button:focus-visible {
    outline: 0.125rem solid var(--color-accent);
    outline-offset: 0.1875rem;
  }
  [data-variant='command'] button {
    min-width: 3.625rem;
    border-color: transparent;
    border-radius: 0.375rem;
    padding-inline: 0.625rem;
  }
  @media (prefers-reduced-motion: reduce) {
    button {
      transition: none;
    }
  }
</style>
