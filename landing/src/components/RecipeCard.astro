---
interface Props {
  title: string
  context: string
  href: string
  linkLabel: string
}
const { title, context, href, linkLabel } = Astro.props
const headingId = `recipe-${crypto.randomUUID()}`
---

<article aria-labelledby={headingId} class:list={['recipe-card']}>
  <div class:list={['recipe-copy']}>
    <span class:list={['recipe-context']}>{context}</span>
    <h3 id={headingId}>{title}</h3>
    <p>
      <slot name="description" />
    </p>
    <a href={href}>
      {linkLabel}
      <span aria-hidden="true">↗</span>
    </a>
  </div>
  <div class:list={['recipe-example']}>
    <slot />
  </div>
</article>

<style>
  .recipe-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 2rem;
    padding-block: 2rem;
    border-top: 0.0625rem solid var(--color-border);
  }
  .recipe-copy {
    display: grid;
    align-content: start;
    gap: 0.875rem;
    min-width: 0;
  }
  .recipe-context {
    color: var(--color-text-subtle);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  h3 {
    color: var(--color-text);
    font-size: 1.375rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.025em;
  }
  p {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.75;
  }
  a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    justify-self: start;
    color: var(--color-accent);
    font-size: 0.875rem;
    line-height: 1.5;
    text-decoration: underline;
    text-underline-offset: 0.1875rem;
  }
  a:hover {
    color: var(--color-text);
  }
  a:focus-visible {
    outline: 0.125rem solid var(--color-accent);
    outline-offset: 0.25rem;
    border-radius: 0.125rem;
  }
  .recipe-example {
    min-width: 0;
  }
  @media (width < 48rem) {
    .recipe-card {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
      padding-block: 1.5rem;
    }
    h3 {
      font-size: 1.25rem;
    }
  }
</style>
