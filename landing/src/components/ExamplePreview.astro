---
import type { Recipe } from '../i18n/translations/en/examples'
import { getI18n } from '../i18n/utils'
import DemoStudio from './DemoStudio.astro'
import DemoPanel from './DemoPanel.astro'
import DemoFooter from './DemoFooter.astro'
import TickerDemo from './TickerDemo.astro'
import ExampleStory from './ExampleStory.astro'
import BrandLogo from './BrandLogo.astro'
import SpeedControl from './SpeedControl.astro'
import Button from '../../../shared/components/Button.astro'
interface Props {
  recipe: Recipe
}
const { recipe } = Astro.props
const t = getI18n(Astro).examples
const base = import.meta.env.BASE_URL
const vertical = recipe.rows.some(row => row.direction === 'up' || row.direction === 'down')
const featured = recipe.rows.some(row => row.featuredPosition)
const directions = vertical ? (['up', 'down'] as const) : (['left', 'right'] as const)
---

<ticker-example-preview
  data-featured-example={featured ? recipe.kind : undefined}
  data-featured-left={t.left}
  data-featured-right={t.right}
  data-featured-top={t.top}
  data-featured-bottom={t.bottom}
  data-added={t.added}
  data-added-status={t.addedStatus}
  data-removed-status={t.removedStatus}
  data-item-empty={t.itemEmpty}
  data-resume-on={t.enabled}
  data-resume-off={t.disabled}
>
  <DemoStudio>
    {recipe.rows.map(row => (
      <DemoPanel label={row.label}>
        <TickerDemo
          kind={recipe.kind === 'logos' || recipe.kind === 'prices' ? recipe.kind : 'news'}
          label={row.label}
          duration={row.duration}
          direction={row.direction}
          speed={row.speed}
          featuredPosition={row.featuredPosition}
          autoplay={row.autoplay}
          interactiveClones={row.interactiveClones}
          pauseOnHover={row.pauseOnHover}
          navigation={row.navigation}
          preserveNavigationPlayback={recipe.id === 'manual-navigation' || featured}
          resumeAfterDrag={row.resumeAfterDrag}
          rtl={row.rtl}
          responsive={row.responsive}
        >
          {row.items.map((item, index) =>
            recipe.kind === 'featured-menu' ? (
              <Button
                variant="secondary"
                context="ticker"
                data-example-feature={`category-${index}`}
                data-featured-description={item.description}
                data-featured={item.featured}
                aria-pressed={!!item.featured}
              >
                {item.label}
              </Button>
            ) : item.description && item.logo && item.href ? (
              <ExampleStory
                title={item.label}
                description={item.description}
                image={`${base}assets/brands/${item.logo}`}
                href={`${base}docs/${item.href}`}
              />
            ) : item.logo && item.featured ? (
              <span class:list={['featured-partner']} data-featured>
                <span class:list={['featured-badge']}>{t.featuredPartner}</span>
                <BrandLogo src={`${base}assets/brands/${item.logo}`} name="" />
                <strong>{item.label}</strong>
              </span>
            ) : item.logo ? (
              <BrandLogo
                src={`${base}assets/brands/${item.logo}`}
                name={item.label}
                data-featured={item.featured}
              />
            ) : (
              <>
                {item.href ? (
                  <a href={`${base}docs/${item.href}`}>{item.label}</a>
                ) : item.value ? (
                  <>
                    <span class:list={['font-semibold']}>{item.label}</span>
                    <span class:list={['price']}>{item.value}</span>
                    <span class:list={[item.change?.startsWith('+') ? 'delta-up' : 'delta-down']}>
                      {item.change}
                    </span>
                  </>
                ) : (
                  <span data-example-item={recipe.kind === 'dynamic' ? `item-${index}` : undefined}>
                    {item.label}
                  </span>
                )}
                <span class:list={['sep']} aria-hidden="true"></span>
              </>
            )
          )}
        </TickerDemo>
        {recipe.kind === 'featured-menu' && (
          <div class:list={['selected-category']} role="status" aria-live="polite">
            <span class:list={['featured-badge']}>{t.selectedCategory}</span>
            <strong data-featured-selection>{row.items.find(item => item.featured)?.label}</strong>
            <p data-featured-description>{row.items.find(item => item.featured)?.description}</p>
          </div>
        )}
      </DemoPanel>
    ))}
    <DemoFooter
      note={recipe.note}
      controls={
        featured ||
        recipe.kind === 'dynamic' ||
        recipe.kind === 'controls' ||
        recipe.kind === 'drag' ||
        vertical
      }
    >
      {featured && (
        <div class:list={['featured-controls']}>
          <div
            role="group"
            aria-label={t.featuredPositionLabel}
            class:list={['direction-controls']}
          >
            <span>{t.featuredPositionLabel}</span>
            {(['start', 'center', 'end'] as const).map(position => (
              <Button
                variant="ghost"
                context="ticker"
                data-example-featured-position={position}
                aria-pressed={recipe.rows[0].featuredPosition === position}
                disabled
              >
                {position === 'center' ? t.center : position === 'start' ? t.left : t.right}
              </Button>
            ))}
          </div>
          <div role="group" aria-label={t.featuredAxisLabel} class:list={['direction-controls']}>
            <span>{t.featuredAxisLabel}</span>
            {(['horizontal', 'vertical'] as const).map(axis => (
              <Button
                variant="ghost"
                context="ticker"
                data-example-featured-axis={axis}
                aria-pressed={axis === 'horizontal'}
                disabled
              >
                {t[axis]}
              </Button>
            ))}
          </div>
        </div>
      )}
      {recipe.kind === 'drag' && (
        <div class:list={['direction-controls']}>
          <Button
            variant="ghost"
            context="ticker"
            data-example-resume
            disabled
            aria-label={t.resumeAfterDrag}
            aria-pressed={recipe.rows[0].resumeAfterDrag === true}
          >
            {t.resumeAfterDrag}
            <span data-resume-state aria-hidden="true">
              {recipe.rows[0].resumeAfterDrag ? t.enabled : t.disabled}
            </span>
          </Button>
        </div>
      )}
      {recipe.kind === 'dynamic' && (
        <div class:list={['feed-actions']}>
          <Button variant="ghost" data-add disabled>
            {t.add}
          </Button>
          <Button variant="ghost" data-remove-first disabled>
            {t.removeFirst}
          </Button>
          <Button variant="ghost" data-remove-last disabled>
            {t.removeLast}
          </Button>
          <label class:list={['item-choice']}>
            {t.itemLabel}
            <select data-item-select disabled>
              <option>{t.itemEmpty}</option>
            </select>
          </label>
          <Button variant="ghost" data-remove-selected disabled>
            {t.removeSelected}
          </Button>
          <label class:list={['item-choice']}>
            {t.positionLabel}
            <select data-item-position disabled>
              <option>{t.itemEmpty}</option>
            </select>
          </label>
          <Button variant="ghost" data-remove-position disabled>
            {t.removeAtPosition}
          </Button>
        </div>
      )}
      {(recipe.kind === 'controls' || vertical) && (
        <>
          {recipe.kind === 'controls' && <SpeedControl />}
          <div role="group" aria-label={t.direction} class:list={['direction-controls']}>
            {directions.map(direction => (
              <Button
                variant="ghost"
                context="ticker"
                data-example-direction={direction}
                aria-pressed={recipe.rows[0].direction === direction}
                disabled
              >
                {t[direction]}
              </Button>
            ))}
          </div>
        </>
      )}
    </DemoFooter>
  </DemoStudio>
  {recipe.kind === 'dynamic' && (
    <p class:list={['update-status']} role="status" aria-live="polite"></p>
  )}
</ticker-example-preview>

<script>
  import { mountElements } from '../../../shared/lib/mount-elements'
  import { getDemoController } from '../lib/demo-controller'
  import { syncSpeedControl } from '../lib/speed-control'

  mountElements('ticker-example-preview', element => {
    const lifecycle = new AbortController()
    const { signal } = lifecycle
    const demo = element.querySelector<HTMLElement>('ticker-demo')
    const controller = () => getDemoController(demo)
    element.addEventListener(
      'click',
      event => {
        const target = event.target
        const button =
          target instanceof Element
            ? target.closest<HTMLButtonElement>('button[data-example-feature]')
            : null
        if (!button) return
        const news = controller()
        if (!news) return
        const original = Array.from(
          element.querySelectorAll<HTMLButtonElement>('button[data-example-feature]')
        ).find(
          item =>
            !item.closest('.ticker-clone') &&
            item.dataset.exampleFeature === button.dataset.exampleFeature
        )
        if (!original) return
        element
          .querySelectorAll<HTMLButtonElement>('button[data-example-feature]')
          .forEach(item => {
            item.setAttribute(
              'aria-pressed',
              String(item.dataset.exampleFeature === original.dataset.exampleFeature)
            )
          })
        news.setFeatured(original)
        const selection = element.querySelector('[data-featured-selection]')
        const description = element.querySelector('[data-featured-description]:not(button)')
        if (selection) selection.textContent = button.textContent
        if (description) description.textContent = button.dataset.featuredDescription ?? ''
      },
      { signal }
    )
    const add = element.querySelector<HTMLButtonElement>('[data-add]')
    const select = element.querySelector<HTMLSelectElement>('[data-item-select]')
    const position = element.querySelector<HTMLSelectElement>('[data-item-position]')
    const resume = element.querySelector<HTMLButtonElement>('button[data-example-resume]')
    const directions = element.querySelectorAll<HTMLButtonElement>('button[data-example-direction]')
    const removeButtons = element.querySelectorAll<HTMLButtonElement>(
      'button[data-remove-first], button[data-remove-last], button[data-remove-selected], button[data-remove-position]'
    )
    const featuredPositions = element.querySelectorAll<HTMLButtonElement>(
      'button[data-example-featured-position]'
    )
    const featuredAxes = element.querySelectorAll<HTMLButtonElement>(
      'button[data-example-featured-axis]'
    )
    const syncFeatured = () => {
      const news = controller()
      const vertical = news?.options.direction === 'up' || news?.options.direction === 'down'
      featuredPositions.forEach(button => {
        const position = button.dataset.exampleFeaturedPosition
        button.disabled = !news
        button.setAttribute('aria-pressed', String(news?.options.featuredPosition === position))
        if (position === 'start')
          button.textContent =
            (vertical ? element.dataset.featuredTop : element.dataset.featuredLeft) ?? ''
        if (position === 'end')
          button.textContent =
            (vertical ? element.dataset.featuredBottom : element.dataset.featuredRight) ?? ''
      })
      featuredAxes.forEach(button => {
        button.disabled = !news
        button.setAttribute(
          'aria-pressed',
          String(button.dataset.exampleFeaturedAxis === (vertical ? 'vertical' : 'horizontal'))
        )
      })
    }
    featuredPositions.forEach(button =>
      button.addEventListener(
        'click',
        () => {
          const position = button.dataset.exampleFeaturedPosition
          if (position !== 'start' && position !== 'center' && position !== 'end') return
          controller()?.update({ featuredPosition: position })
          syncFeatured()
        },
        { signal }
      )
    )
    featuredAxes.forEach(button =>
      button.addEventListener(
        'click',
        () => {
          controller()?.update({
            direction: button.dataset.exampleFeaturedAxis === 'vertical' ? 'up' : 'left',
          })
          syncFeatured()
        },
        { signal }
      )
    )
    const status = element.querySelector('.update-status')
    const items = () => [
      ...(controller()?.source.querySelectorAll<HTMLElement>(
        '.ticker-content:not(.ticker-clone) [data-example-item]'
      ) ?? []),
    ]
    const syncItems = () => {
      if (!select) return
      const selected = select.value
      const current = items()
      select.replaceChildren(
        ...current.map(item => new Option(item.textContent ?? '', item.dataset.exampleItem))
      )
      if (current.some(item => item.dataset.exampleItem === selected)) select.value = selected
      if (!current.length) select.add(new Option(element.dataset.itemEmpty ?? '', ''))
      select.disabled = !current.length
      if (position) {
        const index = Math.min(Number(position.value) || 0, current.length - 1)
        position.replaceChildren(
          ...current.map((_, index) => new Option(String(index + 1), String(index)))
        )
        if (current.length) position.value = String(Math.max(0, index))
        else position.add(new Option(element.dataset.itemEmpty ?? '', ''))
        position.disabled = !current.length
      }
      removeButtons.forEach(button => {
        button.disabled = !current.length
      })
    }
    const sync = () => {
      const news = controller()
      if (add) add.disabled = !news
      if (resume) resume.disabled = !news
      directions.forEach(button => {
        button.disabled = !news
      })
      syncSpeedControl(element.querySelector('ticker-speed'), news?.options.duration)
      syncItems()
      syncFeatured()
    }
    element.addEventListener('ticker:ready', sync, { signal })
    element.querySelector('ticker-speed input')?.addEventListener(
      'input',
      event => {
        controller()?.update({ duration: Number((event.target as HTMLInputElement).value) })
      },
      { signal }
    )
    resume?.addEventListener(
      'click',
      () => {
        const news = controller()
        if (!news) return
        const enabled = !news.options.resumeAfterDrag
        news.update({ resumeAfterDrag: enabled })
        resume.setAttribute('aria-pressed', String(enabled))
        const state = resume.querySelector('[data-resume-state]')
        if (state)
          state.textContent = (enabled ? element.dataset.resumeOn : element.dataset.resumeOff) ?? ''
      },
      { signal }
    )
    directions.forEach(button => {
      button.addEventListener(
        'click',
        () => {
          const direction = button.dataset.exampleDirection
          if (
            direction !== 'left' &&
            direction !== 'right' &&
            direction !== 'up' &&
            direction !== 'down'
          )
            return
          controller()?.update({ direction })
          directions.forEach(item => item.setAttribute('aria-pressed', String(item === button)))
        },
        { signal }
      )
    })
    removeButtons.forEach(button => {
      button.addEventListener(
        'click',
        () => {
          const current = items()
          const item = button.hasAttribute('data-remove-first')
            ? current[0]
            : button.hasAttribute('data-remove-last')
              ? current.at(-1)
              : button.hasAttribute('data-remove-position')
                ? current[Number(position?.value)]
                : current.find(item => item.dataset.exampleItem === select?.value)
          if (!item) return
          const label = item.textContent ?? ''
          const separator = item.nextElementSibling
          if (separator?.classList.contains('sep')) separator.remove()
          item.remove()
          controller()?.refresh()
          syncItems()
          if (status)
            status.textContent = element.dataset.removedStatus?.replace('{item}', label) ?? ''
        },
        { signal }
      )
    })
    let count = 0
    add?.addEventListener(
      'click',
      () => {
        const news = controller()
        const content = news?.source.querySelector('.ticker-content:not(.ticker-clone)')
        if (!news || !content) return
        const item = document.createElement('span')
        item.textContent = element.dataset.added?.replace('{count}', String(++count)) ?? ''
        item.dataset.exampleItem = crypto.randomUUID()
        const separator = document.createElement('span')
        separator.className = 'sep'
        separator.setAttribute('aria-hidden', 'true')
        content.append(item, separator)
        news.refresh()
        syncItems()
        if (status)
          status.textContent = element.dataset.addedStatus?.replace('{count}', String(count)) ?? ''
      },
      { signal }
    )
    sync()
    return () => lifecycle.abort()
  })
</script>

<style>
  ticker-example-preview {
    display: block;
  }
  .featured-controls {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
  }
  .featured-controls .direction-controls {
    align-items: center;
  }
  .featured-controls .direction-controls > span {
    flex-basis: 100%;
  }
  ticker-example-preview[data-featured-example='featured-menu'] :global(.ticker-featured > button) {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--palette-on-accent);
  }
  ticker-example-preview[data-featured-example='featured-menu']
    :global(.ticker-frame[data-axis='vertical'] .ticker-featured > button) {
    flex: 1;
  }
  ticker-example-preview[data-featured-example='logos'] :global(.ticker-featured) {
    justify-content: center;
  }
  ticker-example-preview[data-featured-example='logos']
    :global(.ticker-frame[data-axis='vertical'] .ticker-content) {
    align-items: center;
  }
  .featured-partner {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-sm) var(--space-md);
    min-width: 8rem;
    background: var(--palette-specimen-surface);
    border: 0.125rem solid var(--color-accent);
    border-radius: var(--radius-control);
  }
  .featured-badge {
    font-size: var(--text-small);
    color: var(--color-text-muted);
  }
  .selected-category {
    display: grid;
    gap: var(--space-xs);
    padding: var(--space-md);
    margin-top: var(--space-md);
    border: 0.0625rem solid var(--color-border);
    border-radius: var(--radius-control);
    background: var(--palette-specimen-surface);
  }
  .selected-category p {
    margin: 0;
    font-size: var(--text-small);
    color: var(--color-text-muted);
  }
  .feed-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: var(--space-sm);
    width: 100%;
    min-width: 0;
  }
  .item-choice {
    display: grid;
    gap: var(--space-xs);
    min-width: 0;
    flex: 1 1 10rem;
    color: var(--color-text-muted);
    font-size: var(--text-small);
  }
  .item-choice select {
    width: 100%;
    min-width: 0;
    min-height: 2.75rem;
    padding: 0.5rem;
    font: inherit;
    color: var(--color-text);
    background: var(--color-bg-soft);
    border: 0.0625rem solid var(--color-border);
    border-radius: var(--radius-control);
  }
  .item-choice select:focus-visible {
    outline: 0.125rem solid var(--color-accent);
    outline-offset: 0.1875rem;
  }
  .direction-controls {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }
  .direction-controls [aria-pressed='true'] {
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }
  .update-status {
    color: var(--color-text-muted);
    font-size: var(--text-small);
    margin-top: var(--space-sm);
  }
  .update-status:empty {
    display: none;
  }
</style>
