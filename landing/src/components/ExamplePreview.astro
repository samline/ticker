---
import type { Recipe } from '../i18n/translations/en/examples'
import { getI18n } from '../i18n/utils'
import DemoStudio from './DemoStudio.astro'
import DemoPanel from './DemoPanel.astro'
import DemoFooter from './DemoFooter.astro'
import TickerDemo from './TickerDemo.astro'
import ExampleStory from './ExampleStory.astro'
import BrandLogo from './BrandLogo.astro'
import SpeedControl from './SpeedControl.astro'
import Button from '../../../shared/components/Button.astro'
interface Props {
  recipe: Recipe
}
const { recipe } = Astro.props
const t = getI18n(Astro).examples
const base = import.meta.env.BASE_URL
const vertical = recipe.rows.some(row => row.direction === 'up' || row.direction === 'down')
const directions = vertical ? (['up', 'down'] as const) : (['left', 'right'] as const)
---

<ticker-example-preview
  data-added={t.added}
  data-added-status={t.addedStatus}
  data-removed-status={t.removedStatus}
  data-item-empty={t.itemEmpty}
  data-resume-on={t.enabled}
  data-resume-off={t.disabled}
>
  <DemoStudio>
    {recipe.rows.map(row => (
      <DemoPanel label={row.label}>
        <TickerDemo
          kind={recipe.kind === 'logos' || recipe.kind === 'prices' ? recipe.kind : 'news'}
          label={row.label}
          duration={row.duration}
          direction={row.direction}
          speed={row.speed}
          autoplay={row.autoplay}
          navigation={row.navigation}
          resumeAfterDrag={row.resumeAfterDrag}
          rtl={row.rtl}
          responsive={row.responsive}
        >
          {row.items.map((item, index) =>
            item.description && item.logo && item.href ? (
              <ExampleStory
                title={item.label}
                description={item.description}
                image={`${base}assets/brands/${item.logo}`}
                href={`${base}docs/${item.href}`}
              />
            ) : item.logo ? (
              <BrandLogo src={`${base}assets/brands/${item.logo}`} name={item.label} />
            ) : (
              <>
                {item.href ? (
                  <a href={`${base}docs/${item.href}`}>{item.label}</a>
                ) : item.value ? (
                  <>
                    <span class:list={['font-semibold']}>{item.label}</span>
                    <span class:list={['price']}>{item.value}</span>
                    <span class:list={[item.change?.startsWith('+') ? 'delta-up' : 'delta-down']}>
                      {item.change}
                    </span>
                  </>
                ) : (
                  <span data-example-item={recipe.kind === 'dynamic' ? `item-${index}` : undefined}>
                    {item.label}
                  </span>
                )}
                <span class:list={['sep']} aria-hidden="true"></span>
              </>
            )
          )}
        </TickerDemo>
      </DemoPanel>
    ))}
    <DemoFooter
      note={recipe.note}
      controls={
        recipe.kind === 'dynamic' ||
        recipe.kind === 'controls' ||
        recipe.kind === 'drag' ||
        vertical
      }
    >
      {recipe.kind === 'drag' && (
        <div class:list={['direction-controls']}>
          <Button
            variant="ghost"
            context="ticker"
            data-example-resume
            disabled
            aria-label={t.resumeAfterDrag}
            aria-pressed={recipe.rows[0].resumeAfterDrag === true}
          >
            {t.resumeAfterDrag}
            <span data-resume-state aria-hidden="true">
              {recipe.rows[0].resumeAfterDrag ? t.enabled : t.disabled}
            </span>
          </Button>
        </div>
      )}
      {recipe.kind === 'dynamic' && (
        <div class:list={['feed-actions']}>
          <Button variant="ghost" data-add disabled>
            {t.add}
          </Button>
          <Button variant="ghost" data-remove-first disabled>
            {t.removeFirst}
          </Button>
          <Button variant="ghost" data-remove-last disabled>
            {t.removeLast}
          </Button>
          <label class:list={['item-choice']}>
            {t.itemLabel}
            <select data-item-select disabled>
              <option>{t.itemEmpty}</option>
            </select>
          </label>
          <Button variant="ghost" data-remove-selected disabled>
            {t.removeSelected}
          </Button>
        </div>
      )}
      {(recipe.kind === 'controls' || vertical) && (
        <>
          {recipe.kind === 'controls' && <SpeedControl />}
          <div role="group" aria-label={t.direction} class:list={['direction-controls']}>
            {directions.map(direction => (
              <Button
                variant="ghost"
                context="ticker"
                data-example-direction={direction}
                aria-pressed={recipe.rows[0].direction === direction}
                disabled
              >
                {t[direction]}
              </Button>
            ))}
          </div>
        </>
      )}
    </DemoFooter>
  </DemoStudio>
  {recipe.kind === 'dynamic' && (
    <p class:list={['update-status']} role="status" aria-live="polite"></p>
  )}
</ticker-example-preview>

<script>
  import { mountElements } from '../../../shared/lib/mount-elements'
  import { getDemoController } from '../lib/demo-controller'
  import { syncSpeedControl } from '../lib/speed-control'

  mountElements('ticker-example-preview', element => {
    const lifecycle = new AbortController()
    const { signal } = lifecycle
    const demo = element.querySelector<HTMLElement>('ticker-demo')
    const controller = () => getDemoController(demo)
    const add = element.querySelector<HTMLButtonElement>('[data-add]')
    const select = element.querySelector<HTMLSelectElement>('[data-item-select]')
    const resume = element.querySelector<HTMLButtonElement>('button[data-example-resume]')
    const directions = element.querySelectorAll<HTMLButtonElement>('button[data-example-direction]')
    const removeButtons = element.querySelectorAll<HTMLButtonElement>(
      'button[data-remove-first], button[data-remove-last], button[data-remove-selected]'
    )
    const status = element.querySelector('[role=status]')
    const items = () => [
      ...(controller()?.source.querySelectorAll<HTMLElement>(
        '.ticker-content:not(.ticker-clone) [data-example-item]'
      ) ?? []),
    ]
    const syncItems = () => {
      if (!select) return
      const selected = select.value
      const current = items()
      select.replaceChildren(
        ...current.map(item => new Option(item.textContent ?? '', item.dataset.exampleItem))
      )
      if (current.some(item => item.dataset.exampleItem === selected)) select.value = selected
      if (!current.length) select.add(new Option(element.dataset.itemEmpty ?? '', ''))
      select.disabled = !current.length
      removeButtons.forEach(button => {
        button.disabled = !current.length
      })
    }
    const sync = () => {
      const news = controller()
      if (add) add.disabled = !news
      if (resume) resume.disabled = !news
      directions.forEach(button => {
        button.disabled = !news
      })
      syncSpeedControl(element.querySelector('ticker-speed'), news?.options.duration)
      syncItems()
    }
    element.addEventListener('ticker:ready', sync, { signal })
    element.querySelector('ticker-speed input')?.addEventListener(
      'input',
      event => {
        controller()?.update({ duration: Number((event.target as HTMLInputElement).value) })
      },
      { signal }
    )
    resume?.addEventListener(
      'click',
      () => {
        const news = controller()
        if (!news) return
        const enabled = !news.options.resumeAfterDrag
        news.update({ resumeAfterDrag: enabled })
        resume.setAttribute('aria-pressed', String(enabled))
        const state = resume.querySelector('[data-resume-state]')
        if (state)
          state.textContent = (enabled ? element.dataset.resumeOn : element.dataset.resumeOff) ?? ''
      },
      { signal }
    )
    directions.forEach(button => {
      button.addEventListener(
        'click',
        () => {
          const direction = button.dataset.exampleDirection
          if (
            direction !== 'left' &&
            direction !== 'right' &&
            direction !== 'up' &&
            direction !== 'down'
          )
            return
          controller()?.update({ direction })
          directions.forEach(item => item.setAttribute('aria-pressed', String(item === button)))
        },
        { signal }
      )
    })
    removeButtons.forEach(button => {
      button.addEventListener(
        'click',
        () => {
          const current = items()
          const item = button.hasAttribute('data-remove-first')
            ? current[0]
            : button.hasAttribute('data-remove-last')
              ? current.at(-1)
              : current.find(item => item.dataset.exampleItem === select?.value)
          if (!item) return
          const label = item.textContent ?? ''
          const separator = item.nextElementSibling
          if (separator?.classList.contains('sep')) separator.remove()
          item.remove()
          controller()?.refresh()
          syncItems()
          if (status)
            status.textContent = element.dataset.removedStatus?.replace('{item}', label) ?? ''
        },
        { signal }
      )
    })
    let count = 0
    add?.addEventListener(
      'click',
      () => {
        const news = controller()
        const content = news?.source.querySelector('.ticker-content:not(.ticker-clone)')
        if (!news || !content) return
        const item = document.createElement('span')
        item.textContent = element.dataset.added?.replace('{count}', String(++count)) ?? ''
        item.dataset.exampleItem = crypto.randomUUID()
        const separator = document.createElement('span')
        separator.className = 'sep'
        separator.setAttribute('aria-hidden', 'true')
        content.append(item, separator)
        news.refresh()
        syncItems()
        if (status)
          status.textContent = element.dataset.addedStatus?.replace('{count}', String(count)) ?? ''
      },
      { signal }
    )
    sync()
    return () => lifecycle.abort()
  })
</script>

<style>
  ticker-example-preview {
    display: block;
  }
  .feed-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: var(--space-sm);
    width: 100%;
    min-width: 0;
  }
  .item-choice {
    display: grid;
    gap: var(--space-xs);
    min-width: 0;
    flex: 1 1 10rem;
    color: var(--color-text-muted);
    font-size: var(--text-small);
  }
  .item-choice select {
    width: 100%;
    min-width: 0;
    min-height: 2.75rem;
    padding: 0.5rem;
    font: inherit;
    color: var(--color-text);
    background: var(--color-bg-soft);
    border: 0.0625rem solid var(--color-border);
    border-radius: var(--radius-control);
  }
  .item-choice select:focus-visible {
    outline: 0.125rem solid var(--color-accent);
    outline-offset: 0.1875rem;
  }
  .direction-controls {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }
  .direction-controls [aria-pressed='true'] {
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }
  .update-status {
    color: var(--color-text-muted);
    font-size: var(--text-small);
    margin-top: var(--space-sm);
  }
  .update-status:empty {
    display: none;
  }
</style>
