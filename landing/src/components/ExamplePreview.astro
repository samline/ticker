---
import type { Recipe } from '../i18n/translations/en/examples'
import { getI18n } from '../i18n/utils'
import DemoStudio from './DemoStudio.astro'
import DemoPanel from './DemoPanel.astro'
import DemoFooter from './DemoFooter.astro'
import TickerDemo from './TickerDemo.astro'
import ExampleStory from './ExampleStory.astro'
import BrandLogo from './BrandLogo.astro'
import SpeedControl from './SpeedControl.astro'
import Button from '../../../shared/components/Button.astro'
interface Props {
  recipe: Recipe
}
const { recipe } = Astro.props
const t = getI18n(Astro).examples
const base = import.meta.env.BASE_URL
const vertical = recipe.rows.some(row => row.direction === 'up' || row.direction === 'down')
const directions = vertical ? (['up', 'down'] as const) : (['left', 'right'] as const)
---

<ticker-example-preview
  data-added={t.added}
  data-added-status={t.addedStatus}
  data-removed-status={t.removedStatus}
  data-item-empty={t.itemEmpty}
  data-resume-on={t.enabled}
  data-resume-off={t.disabled}
>
  <DemoStudio>
    {recipe.rows.map(row => (
      <DemoPanel label={row.label}>
        <TickerDemo
          kind={recipe.kind === 'logos' || recipe.kind === 'prices' ? recipe.kind : 'news'}
          label={row.label}
          duration={row.duration}
          direction={row.direction}
          speed={row.speed}
          autoplay={row.autoplay}
          navigation={row.navigation}
          resumeAfterDrag={row.resumeAfterDrag}
          rtl={row.rtl}
          responsive={row.responsive}
        >
          {row.items.map((item, index) =>
            item.description && item.logo && item.href ? (
              <ExampleStory
                title={item.label}
                description={item.description}
                image={`${base}assets/brands/${item.logo}`}
                href={`${base}docs/${item.href}`}
              />
            ) : item.logo ? (
              <BrandLogo src={`${base}assets/brands/${item.logo}`} name={item.label} />
            ) : (
              <>
                {item.href ? (
                  <a href={`${base}docs/${item.href}`}>{item.label}</a>
                ) : item.value ? (
                  <>
                    <span class:list={['font-semibold']}>{item.label}</span>
                    <span class:list={['price']}>{item.value}</span>
                    <span class:list={[item.change?.startsWith('+') ? 'delta-up' : 'delta-down']}>
                      {item.change}
                    </span>
                  </>
                ) : (
                  <span data-example-item={recipe.kind === 'dynamic' ? `item-${index}` : undefined}>
                    {item.label}
                  </span>
                )}
                <span class:list={['sep']} aria-hidden="true"></span>
              </>
            )
          )}
        </TickerDemo>
      </DemoPanel>
    ))}
    <DemoFooter
      note={recipe.note}
      controls={
        recipe.kind === 'dynamic' ||
        recipe.kind === 'controls' ||
        recipe.kind === 'drag' ||
        vertical
      }
    >
      {recipe.kind === 'drag' && (
        <div class:list={['direction-controls']}>
          <Button
            variant="ghost"
            context="ticker"
            data-example-resume
            disabled
            aria-label={t.resumeAfterDrag}
            aria-pressed={recipe.rows[0].resumeAfterDrag === true}
          >
            {t.resumeAfterDrag}
            <span data-resume-state aria-hidden="true">
              {recipe.rows[0].resumeAfterDrag ? t.enabled : t.disabled}
            </span>
          </Button>
        </div>
      )}
      {recipe.kind === 'dynamic' && (
        <div class:list={['feed-actions']}>
          <Button variant="ghost" data-add disabled>
            {t.add}
          </Button>
          <Button variant="ghost" data-remove-first disabled>
            {t.removeFirst}
          </Button>
          <Button variant="ghost" data-remove-last disabled>
            {t.removeLast}
          </Button>
          <label class:list={['item-choice']}>
            {t.itemLabel}
            <select data-item-select disabled>
              <option>{t.itemEmpty}</option>
            </select>
          </label>
          <Button variant="ghost" data-remove-selected disabled>
            {t.removeSelected}
          </Button>
        </div>
      )}
      {(recipe.kind === 'controls' || vertical) && (
        <>
          {recipe.kind === 'controls' && <SpeedControl />}
          <div role="group" aria-label={t.direction} class:list={['direction-controls']}>
            {directions.map(direction => (
              <Button
                variant="ghost"
                context="ticker"
                data-example-direction={direction}
                aria-pressed={recipe.rows[0].direction === direction}
                disabled
              >
                {t[direction]}
              </Button>
            ))}
          </div>
        </>
      )}
    </DemoFooter>
  </DemoStudio>
  {recipe.kind === 'dynamic' && (
    <p class:list={['update-status']} role="status" aria-live="polite"></p>
  )}
</ticker-example-preview>
<script>
  class TickerExamplePreview extends HTMLElement {
    private lifecycle?: AbortController
    connectedCallback() {
      this.lifecycle?.abort()
      this.lifecycle = new AbortController()
      const { signal } = this.lifecycle
      const demo = this.querySelector<HTMLElement>('ticker-demo')
      const add = this.querySelector<HTMLButtonElement>('[data-add]')
      const select = this.querySelector<HTMLSelectElement>('[data-item-select]')
      const resume = this.querySelector<HTMLButtonElement>('button[data-example-resume]')
      let items: Array<{ id: string; label: string }> = []
      const removeButtons = this.querySelectorAll<HTMLButtonElement>(
        'button[data-remove-first], button[data-remove-last], button[data-remove-selected]'
      )
      const sync = () => {
        const enabled = demo?.dataset.initialized === 'true'
        if (add) add.disabled = !enabled
        if (resume) resume.disabled = !enabled
        if (enabled && select) demo?.dispatchEvent(new CustomEvent('ticker:list'))
        this.querySelectorAll<HTMLButtonElement>('button[data-example-direction]').forEach(
          button => {
            button.disabled = !enabled
          }
        )
        this.querySelector('ticker-speed')?.dispatchEvent(
          new CustomEvent('speed:set', {
            detail: { duration: Number(demo?.dataset.duration), enabled },
          })
        )
      }
      this.addEventListener('ticker:ready', sync, { signal })
      resume?.addEventListener(
        'click',
        () => {
          const enabled = resume.getAttribute('aria-pressed') !== 'true'
          demo?.dispatchEvent(new CustomEvent('ticker:resume-after-drag', { detail: enabled }))
          resume.setAttribute('aria-pressed', String(enabled))
          const state = resume.querySelector('[data-resume-state]')
          if (state)
            state.textContent = (enabled ? this.dataset.resumeOn : this.dataset.resumeOff) ?? ''
        },
        { signal }
      )
      this.addEventListener(
        'speed:change',
        event =>
          demo?.dispatchEvent(
            new CustomEvent('ticker:duration', { detail: (event as CustomEvent<number>).detail })
          ),
        { signal }
      )
      this.addEventListener(
        'click',
        event => {
          const button = (event.target as Element).closest<HTMLButtonElement>(
            'button[data-example-direction]'
          )
          const direction = button?.dataset.exampleDirection
          if (
            direction !== 'left' &&
            direction !== 'right' &&
            direction !== 'up' &&
            direction !== 'down'
          )
            return
          demo?.dispatchEvent(new CustomEvent('ticker:direction', { detail: direction }))
          this.querySelectorAll<HTMLButtonElement>('button[data-example-direction]').forEach(item =>
            item.setAttribute('aria-pressed', String(item === button))
          )
        },
        { signal }
      )
      this.addEventListener(
        'ticker:items',
        event => {
          if (!select) return
          items = (event as CustomEvent<Array<{ id: string; label: string }>>).detail
          const selected = select.value
          select.replaceChildren(...items.map(item => new Option(item.label, item.id)))
          if (items.some(item => item.id === selected)) select.value = selected
          if (!items.length) select.add(new Option(this.dataset.itemEmpty ?? '', ''))
          select.disabled = !items.length
          removeButtons.forEach(button => {
            button.disabled = !items.length
          })
        },
        { signal }
      )
      removeButtons.forEach(button =>
        button.addEventListener(
          'click',
          () => {
            const item = button.hasAttribute('data-remove-first')
              ? items[0]
              : button.hasAttribute('data-remove-last')
                ? items.at(-1)
                : items.find(item => item.id === select?.value)
            if (!item) return
            demo?.dispatchEvent(new CustomEvent('ticker:remove', { detail: item.id }))
            const status = this.querySelector('[role=status]')
            if (status)
              status.textContent = this.dataset.removedStatus?.replace('{item}', item.label) ?? ''
          },
          { signal }
        )
      )
      let count = 0
      add?.addEventListener(
        'click',
        () => {
          count++
          demo?.dispatchEvent(
            new CustomEvent('ticker:append', {
              detail: this.dataset.added?.replace('{count}', String(count)) ?? '',
            })
          )
          const status = this.querySelector('[role=status]')
          if (status)
            status.textContent = this.dataset.addedStatus?.replace('{count}', String(count)) ?? ''
        },
        { signal }
      )
      Promise.all(
        ['ticker-demo', 'ticker-speed'].map(name => customElements.whenDefined(name))
      ).then(() => {
        if (!signal.aborted) sync()
      })
    }
    disconnectedCallback() {
      this.lifecycle?.abort()
    }
  }
  if (!customElements.get('ticker-example-preview'))
    customElements.define('ticker-example-preview', TickerExamplePreview)
</script>
<style>
  ticker-example-preview {
    display: block;
  }
  .feed-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: var(--space-sm);
    width: 100%;
    min-width: 0;
  }
  .item-choice {
    display: grid;
    gap: var(--space-xs);
    min-width: 0;
    flex: 1 1 10rem;
    color: var(--color-text-muted);
    font-size: var(--text-small);
  }
  .item-choice select {
    width: 100%;
    min-width: 0;
    min-height: 2.75rem;
    padding: 0.5rem;
    font: inherit;
    color: var(--color-text);
    background: var(--color-bg-soft);
    border: 0.0625rem solid var(--color-border);
    border-radius: var(--radius-control);
  }
  .item-choice select:focus-visible {
    outline: 0.125rem solid var(--color-accent);
    outline-offset: 0.1875rem;
  }
  .direction-controls {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }
  .direction-controls [aria-pressed='true'] {
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }
  .update-status {
    color: var(--color-text-muted);
    font-size: var(--text-small);
    margin-top: var(--space-sm);
  }
  .update-status:empty {
    display: none;
  }
</style>
