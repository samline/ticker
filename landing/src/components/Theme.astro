<script is:inline>
  ;(() => {
    let preference
    try {
      preference = localStorage.getItem('ticker-theme')
    } catch {}
    const theme =
      preference === 'light' || preference === 'dark'
        ? preference
        : matchMedia('(prefers-color-scheme: dark)').matches
          ? 'dark'
          : 'light'
    document.documentElement.dataset.theme = theme
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute('content', theme === 'dark' ? '#1d1c23' : '#faf9fc')
  })()
</script>
<script>
  const root = document.documentElement
  const system = matchMedia('(prefers-color-scheme: dark)')
  let manual = false
  try {
    manual = ['light', 'dark'].includes(localStorage.getItem('ticker-theme') ?? '')
  } catch {}
  function apply(theme: 'light' | 'dark') {
    root.dataset.theme = theme
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute('content', theme === 'dark' ? '#1d1c23' : '#faf9fc')
    document.dispatchEvent(new CustomEvent('ticker:theme-change', { detail: theme }))
  }
  document.addEventListener('ticker:theme-request', event => {
    const theme = (event as CustomEvent<'light' | 'dark'>).detail
    if (theme !== 'light' && theme !== 'dark') return
    manual = true
    try {
      localStorage.setItem('ticker-theme', theme)
    } catch {}
    apply(theme)
  })
  system.addEventListener('change', event => {
    if (!manual) apply(event.matches ? 'dark' : 'light')
  })
</script>
