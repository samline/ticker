---
import type { HTMLAttributes } from 'astro/types'
interface Props extends HTMLAttributes<'span'> {
  name: string
  src: string
  size?: 'default' | 'compact'
}
const { name, src, size = 'default', ...attributes } = Astro.props
---

<span {...attributes} class:list={['brand-logo', { compact: size === 'compact' }]}>
  <img src={src} alt={name} decoding="async" />
</span>

<style>
  .brand-logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 7.25rem;
    height: 4rem;
    flex: 0 0 auto;
    border: 0.0625rem solid var(--palette-brand-border);
    border-radius: 0.625rem;
    background: var(--palette-brand-surface);
  }
  .brand-logo img {
    filter: var(--brand-logo-filter);
    display: block;
    width: 2.25rem;
    height: 2.25rem;
    object-fit: contain;
    opacity: 0.82;
  }
  .brand-logo.compact {
    width: 3.5rem;
    height: 3.5rem;
  }
  .brand-logo.compact img {
    width: 1.75rem;
    height: 1.75rem;
  }
  @media (width < 48rem) {
    .brand-logo {
      width: 6rem;
    }
  }
</style>
