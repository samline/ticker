---
import { readFile } from 'node:fs/promises'
import { resolve } from 'node:path'
import { format as formatCode, resolveConfig } from 'prettier'
import { escapeXml, serializeJsonLd } from '../../../shared/lib/serialize'
import { format } from '../../../shared/i18n/format'
import { getI18n } from '../i18n/utils'
import type { Recipe } from '../i18n/translations/en/examples'
import ExamplePreview from './ExamplePreview.astro'
import Heading from '../../../shared/components/Heading.astro'
import TextLink from '../../../shared/components/TextLink.astro'
import Disclosure from '../../../shared/components/Disclosure.astro'
import Tabs from '../../../shared/components/Tabs.astro'
import TabPanel from '../../../shared/components/TabPanel.astro'
import CodeFiles from '../../../shared/components/CodeFiles.astro'
import manifest from '../../../package.json'
interface Props {
  recipe: Recipe
}
const { recipe } = Astro.props
const i18n = getI18n(Astro)
const t = i18n.examples
const playback = i18n.controls.ticker
const base = import.meta.env.BASE_URL
const docsBase = `${manifest.homepage.replace(/\/$/, '')}/docs/`
const cdn = `https://cdn.jsdelivr.net/npm/${manifest.name}@${manifest.version}/dist/`
const e = escapeXml
const themeSource = await readFile(resolve('../shared/styles/theme.css'), 'utf8')
const palette = (theme: 'light' | 'dark') => {
  const block = themeSource.match(new RegExp(`\\[data-theme='${theme}'\\] \\{([^}]+)\\}`))?.[1]
  if (!block) throw new Error(`Missing recipe theme: ${theme}`)
  const tokens = Object.fromEntries(
    [...block.matchAll(/(--[\w-]+):\s*([^;]+);/g)].map(match => [match[1], match[2]])
  )
  return Object.entries({
    bg: '--theme-bg',
    text: '--theme-text',
    surface: '--theme-surface',
    border: '--theme-border',
    accent: '--theme-accent',
    up: '--palette-price-up',
    down: '--palette-price-down',
    hover: '--palette-button-hover',
  })
    .map(([name, token]) => {
      if (!tokens[token]) throw new Error(`Missing recipe color: ${token}`)
      return `--${name}: ${tokens[token]};`
    })
    .join(' ')
}
const rows = await Promise.all(
  recipe.rows.map(async (row, rowIndex) => {
    const items = await Promise.all(
      row.items.map(async (item, index) => {
        if (item.logo) {
          const svg = await readFile(resolve('public/assets/brands', item.logo), 'utf8')
          if (item.description && item.href)
            return `<div class="item story-item"><span class="story-image"><img src="data:image/svg+xml,${encodeURIComponent(svg)}" alt=""></span><span class="story-copy"><a href="${e(docsBase + item.href)}">${e(item.label)}</a><span>${e(item.description)}</span></span></div>`
          return `<span class="item"><img src="data:image/svg+xml,${encodeURIComponent(svg)}" alt="">${e(item.label)}</span>`
        }
        if (item.href)
          return `<a class="item" href="${e(docsBase + item.href)}" target="_blank" rel="noopener noreferrer">${e(item.label)}</a>`
        if (item.value)
          return `<span class="item"><strong>${e(item.label)}</strong> ${e(item.value)} <span class="${item.change?.startsWith('+') ? 'up' : 'down'}">${e(item.change ?? '')}</span></span>`
        return `<span class="item"${recipe.kind === 'dynamic' ? ` data-example-item="item-${index}"` : ''}>${e(item.label)}</span>`
      })
    )
    return `<div class="window" dir="${row.rtl ? 'rtl' : 'ltr'}" data-vertical="${row.direction === 'up' || row.direction === 'down'}" tabindex="0" role="region" aria-label="${e(row.label)}" aria-live="off">
  <div id="ticker-${rowIndex + 1}" data-row>${items.join('\n    ')}</div>
</div>`
  })
)
const controls =
  recipe.kind === 'controls'
    ? `
  <label>${e(t.speed)} <input type="range" min="14" max="60" value="24" aria-label="${e(t.speed)}"><output>24s</output></label>
  <label>${e(t.direction)} <select data-example-direction-select aria-label="${e(t.direction)}"><option value="left">${e(t.left)}</option><option value="right">${e(t.right)}</option></select></label>`
    : recipe.rows.some(row => row.navigation)
      ? `
  <button type="button" data-previous>${e(playback.previous)}</button><button type="button" data-next>${e(playback.next)}</button>
  <label>${e(playback.position)} <input type="range" data-position min="0" max="1" value="0"></label>`
      : ''
const verticalControls = recipe.rows.some(row => row.direction === 'up' || row.direction === 'down')
  ? `<div role="group" aria-label="${e(t.direction)}"><button type="button" data-example-direction="up" aria-pressed="true">${e(t.up)}</button><button type="button" data-example-direction="down" aria-pressed="false">${e(t.down)}</button></div>`
  : ''
const dragControls =
  recipe.kind === 'drag'
    ? `<button type="button" data-example-resume aria-label="${e(t.resumeAfterDrag)}" aria-pressed="${recipe.rows[0].resumeAfterDrag === true}">${e(t.resumeAfterDrag)} <span data-resume-state aria-hidden="true">${e(recipe.rows[0].resumeAfterDrag ? t.enabled : t.disabled)}</span></button>`
    : ''
const markup = `<section class="ticker-recipe">
  <h1>${e(recipe.title)}</h1>
  ${rows.join('\n  ')}
  <div class="controls" hidden>
    <button type="button" data-pause>${e(playback.pause)}</button>${
      recipe.kind === 'dynamic'
        ? `
    <button type="button" data-add>${e(t.add)}</button>
    <button type="button" data-remove-first>${e(t.removeFirst)}</button>
    <button type="button" data-remove-last>${e(t.removeLast)}</button>
    <label>${e(t.itemLabel)} <select data-item-select></select></label>
    <button type="button" data-remove-selected>${e(t.removeSelected)}</button>`
        : ''
    }${controls}${verticalControls}${dragControls}
  </div>
  <p>${e(recipe.note)}</p>${recipe.rows.some(row => row.items.some(item => item.logo)) ? `\n  <p><a href="${e(manifest.homepage + '/attribution/')}" target="_blank" rel="noopener noreferrer">${e(t.brandAttribution)}</a></p>` : ''}
  <p role="status" aria-live="polite"></p>
  <noscript><p>${e(t.noJs)}</p></noscript>
</section>`
// Standalone copied files need their own styles. Site previews reuse the landing components.
const css = `body { margin: 0; font: 1rem/1.6 system-ui, sans-serif; }
.ticker-recipe {
  ${palette('light')}
  display: block; padding: 1rem; background: var(--bg); color: var(--text);
}
@media (prefers-color-scheme: dark) {
  .ticker-recipe { ${palette('dark')} }
}
@scope (.ticker-recipe) {
  h1 { margin: 0 0 1rem; font-size: 1.125rem; font-weight: 500; }
  .window { overflow-x: auto; margin-block: 0.75rem; border: 0.0625rem solid var(--border); border-radius: 0.75rem; background: var(--surface); }
  [data-row] { display: flex; align-items: center; gap: 1.5rem; width: max-content; }
  .ticker-track { gap: 1.5rem; padding-block: 1rem; }
  .item { display: inline-flex; align-items: center; gap: 0.625rem; white-space: nowrap; padding-inline: 0.25rem; }
  a { color: var(--accent); text-underline-offset: 0.1875rem; }
  img { width: 2rem; height: 2rem; object-fit: contain; }
  .up { color: var(--up); } .down { color: var(--down); }
  .controls { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; margin-top: 1rem; }
  button, select { font: inherit; padding: 0.375rem 0.75rem; background: var(--surface); color: var(--text); border: 0.0625rem solid var(--border); border-radius: 0.5rem; cursor: pointer; }
  @media (hover: hover) { button:hover, select:hover { background: var(--hover); } }
  select { max-width: 100%; min-width: 0; }
  label { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
  input { accent-color: var(--accent); width: 6rem; } output { font-variant-numeric: tabular-nums; }
  p { margin: 0.75rem 0 0; font-size: 0.8125rem; } p:empty { display: none; }
  [hidden] { display: none !important; }
  :focus-visible { outline: 0.125rem solid var(--accent); outline-offset: 0.1875rem; }
  .window:focus-visible { outline-offset: -0.1875rem; }
  .window[data-vertical="true"] .ticker-wrapper { height: 22rem; }
  .window[data-vertical="true"] [data-row] { flex-direction: column; width: 100%; align-items: stretch; gap: 1rem; }
  .window[data-vertical="true"] .ticker-track { gap: 1rem; padding-block: 0.5rem; }
  .window[data-vertical="true"] .item { white-space: normal; }
  .story-item { display: grid; grid-template-columns: 3.5rem minmax(0, 1fr); align-items: start; gap: 1rem; width: 100%; box-sizing: border-box; padding: 1rem; border: 0.0625rem solid var(--border); border-radius: 1rem; background: var(--surface); }
  .story-image { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border: 0.0625rem solid var(--border); border-radius: 0.625rem; }
  .story-image img { width: 1.75rem; height: 1.75rem; filter: brightness(0.55) saturate(1.3); }
  .story-copy { display: grid; min-width: 0; gap: 0.5rem; font-size: 0.8125rem; line-height: 1.6; }
  .story-copy a { font-size: 0.875rem; }
  @media (prefers-color-scheme: dark) { .story-image img { filter: none; } }
}
@media (prefers-reduced-motion: reduce) {
  .ticker-recipe [data-pause] { display: none; }
}`
// Generate only the controls used by this recipe; copied code is plain JavaScript.
const js = serializeJsonLd
const multiple = recipe.rows.length > 1
const createTicker = (row: Recipe['rows'][number], index: number) => {
  const { items, label, rtl, ...options } = row
  return `ticker('#ticker-${index + 1}', ${js({ ...options, pauseOnHover: true })})`
}
const applyToTickers = (statement: string) =>
  multiple ? `tickers.forEach(news => { ${statement} });` : statement
const behavior = `
${
  multiple
    ? `const tickers = [${recipe.rows.map(createTicker).join(',')}].filter(Boolean);
const news = tickers[0];`
    : `const news = ${createTicker(recipe.rows[0], 0)};`
}

if (news) {
  const lifecycle = new AbortController();
  const { signal } = lifecycle;
  const example = document.querySelector('.ticker-recipe');
  const pauseButton = example.querySelector('[data-pause]');
  const renderPlayback = () => {
    const playing = ${multiple ? 'tickers.some(item => item.state.requested)' : 'news.state.requested'};
    example.dataset.paused = String(!playing);
    pauseButton.textContent = playing ? ${js(playback.pause)} : ${js(playback.play)};
  };
  ${applyToTickers("news.on('playback', renderPlayback);")}
  renderPlayback();
  example.querySelector('.controls').hidden = false;
  pauseButton.addEventListener('click', () => {
    const playing = ${multiple ? 'tickers.some(item => item.state.requested)' : 'news.state.requested'};
    ${applyToTickers('playing ? news.pause() : news.play();')}
  }, { signal });
  ${
    recipe.rows.some(row => row.navigation)
      ? `
  news.connectControls({
    previous: example.querySelector('[data-previous]'),
    next: example.querySelector('[data-next]'),
    rail: example.querySelector('[data-position]'),
  });`
      : ''
  }
  ${
    recipe.kind === 'drag'
      ? `
  const resumeButton = example.querySelector('[data-example-resume]');
  resumeButton.addEventListener('click', () => {
    const enabled = !news.options.resumeAfterDrag;
    news.update({ resumeAfterDrag: enabled });
    resumeButton.setAttribute('aria-pressed', String(enabled));
    resumeButton.querySelector('[data-resume-state]').textContent = enabled ? ${js(t.enabled)} : ${js(t.disabled)};
  }, { signal });`
      : ''
  }
  ${
    recipe.kind === 'controls'
      ? `
  const duration = example.querySelector('input');
  const output = example.querySelector('output');
  duration.addEventListener('input', () => {
    news.update({ duration: Number(duration.value) });
    output.value = duration.value + 's';
  }, { signal });
  const direction = example.querySelector('[data-example-direction-select]');
  direction.addEventListener('change', () => {
    news.update({ direction: direction.value });
  }, { signal });`
      : ''
  }
  ${
    verticalControls
      ? `
  const directions = example.querySelectorAll('button[data-example-direction]');
  directions.forEach(button => {
    button.addEventListener('click', () => {
      news.update({ direction: button.dataset.exampleDirection });
      directions.forEach(item => item.setAttribute('aria-pressed', String(item === button)));
    }, { signal });
  });`
      : ''
  }
  ${
    recipe.kind === 'dynamic'
      ? `
  const select = example.querySelector('[data-item-select]');
  const status = example.querySelector('[role=status]');
  const items = () => [...news.source.querySelectorAll('[data-example-item]')];
  const removeButtons = example.querySelectorAll('[data-remove-first], [data-remove-last], [data-remove-selected]');
  const syncItems = () => {
    const selected = select.value;
    const current = items();
    select.replaceChildren(...current.map(item => new Option(item.textContent, item.dataset.exampleItem)));
    if (current.some(item => item.dataset.exampleItem === selected)) select.value = selected;
    if (!current.length) select.add(new Option(${js(t.itemEmpty)}, ''));
    select.disabled = !current.length;
    removeButtons.forEach(button => { button.disabled = !current.length; });
  };
  const removeItem = item => {
    if (!item) return;
    const label = item.textContent;
    item.remove();
    news.refresh();
    syncItems();
    status.textContent = ${js(t.removedStatus)}.replace('{item}', label);
  };
  example.querySelector('[data-remove-first]').addEventListener('click', () => removeItem(items()[0]), { signal });
  example.querySelector('[data-remove-last]').addEventListener('click', () => removeItem(items().at(-1)), { signal });
  example.querySelector('[data-remove-selected]').addEventListener('click', () => {
    removeItem(items().find(item => item.dataset.exampleItem === select.value));
  }, { signal });
  syncItems();
  let count = 0;
  example.querySelector('[data-add]').addEventListener('click', () => {
    const item = document.createElement('span');
    item.className = 'item';
    item.dataset.exampleItem = 'added-' + ++count;
    item.textContent = ${js(t.added)}.replace('{count}', String(count));
    news.source.append(item);
    news.refresh();
    syncItems();
    status.textContent = ${js(t.addedStatus)}.replace('{count}', String(count));
  }, { signal });`
      : ''
  }
  document.fonts.ready.then(() => {
    if (!signal.aborted) { ${applyToTickers('news.refresh();')} }
  });
  window.addEventListener('pagehide', () => {
    lifecycle.abort();
    ${applyToTickers('news.destroy();')}
  }, { once: true });
}`
const scriptFor = (mode: 'cdn' | 'npm') =>
  `${mode === 'cdn' ? 'const ticker = window.Ticker.ticker;' : `import { ticker } from '${manifest.name}';\nimport '${manifest.name}/style.css';`}\n${behavior}`
const documentFor = (mode: 'cdn' | 'npm', separate = false) => `<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>${e(recipe.title)}</title>
${mode === 'cdn' ? `<link rel="stylesheet" href="${cdn}style.css">` : ''}
${separate ? '<link rel="stylesheet" href="./style.css">' : `<style>\n${css}\n</style>`}
</head>
<body>
<main aria-label="${e(recipe.title)}">
${markup}
</main>
${mode === 'cdn' ? `<script src="${cdn}browser/global.global.js"></script>` : ''}
${separate ? '<script type="module" src="./main.js"></script>' : `<script type="module">\n${scriptFor(mode)}\n</script>`}
</body>
</html>`
const codeOptions = await resolveConfig(resolve('src/components/ExampleRecipe.astro'))
const fileLabels = i18n.controls.codeFiles
const filesFor = async (mode: 'cdn' | 'npm') => [
  {
    id: 'html',
    label: fileLabels.html,
    filename: 'index.html',
    language: 'html' as const,
    code: await formatCode(documentFor(mode, true), { ...codeOptions, parser: 'html' }),
  },
  {
    id: 'css',
    label: fileLabels.css,
    filename: 'style.css',
    language: 'css' as const,
    code: await formatCode(css, { ...codeOptions, parser: 'css' }),
  },
  {
    id: 'js',
    label: fileLabels.javascript,
    filename: 'main.js',
    language: 'javascript' as const,
    code: await formatCode(scriptFor(mode), { ...codeOptions, parser: 'babel' }),
  },
]
const documents = {
  cdn: {
    code: await formatCode(documentFor('cdn'), { ...codeOptions, parser: 'html' }),
    files: await filesFor('cdn'),
  },
  npm: {
    code: await formatCode(documentFor('npm'), { ...codeOptions, parser: 'html' }),
    files: await filesFor('npm'),
  },
}
---

<section id={recipe.id} class:list={['recipe']} aria-labelledby={`${recipe.id}-title`}>
  <div class:list={['recipe-heading']}>
    <Heading level={2} id={`${recipe.id}-title`}>
      {recipe.title}
    </Heading>
    <p>{recipe.description}</p>
  </div>
  <div class:list={['recipe-preview']}>
    <ExamplePreview recipe={recipe} />
    <TextLink compact href={`${base}docs/${recipe.docsPath}`}>
      {recipe.docsLabel}
    </TextLink>
  </div>
  <Disclosure class:list={['code-disclosure']}>
    <span slot="summary">{t.code}</span>
    <div class:list={['code-body']}>
      <div class:list={['code-notes']}>
        <p class:list={['note']}>{t.instructions}</p>
        <p class:list={['note']}>{t.sourceNote}</p>
      </div>
      <Tabs id={`example-${recipe.id}`} label={t.format} items={t.formats}>
        {t.formats.map(item => (
          <TabPanel id={item.id} label={item.label} class:list={['example-code-panel']}>
            <CodeFiles
              files={documents[item.id].files}
              complete={{
                code: documents[item.id].code,
                filename: t.file,
                copyLabel: format(t.copy, { format: item.label, title: recipe.title }),
              }}
            />
          </TabPanel>
        ))}
      </Tabs>
    </div>
  </Disclosure>
</section>
<style>
  .recipe {
    --recipe-top-space: 2.5rem;
    padding-block: var(--recipe-top-space);
    border-top: 0.0625rem solid var(--color-border-soft);
  }
  .recipe[id] {
    scroll-margin-top: calc(var(--header-offset, 9rem) - var(--recipe-top-space) - 0.0625rem);
  }
  .recipe-heading {
    display: grid;
    overflow-wrap: anywhere;
    gap: 0.75rem;
    margin-bottom: var(--space-lg);
  }
  .recipe-preview {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-lg);
  }
  p {
    color: var(--color-text-muted);
    line-height: 1.75;
  }
  .note {
    font-size: var(--text-small);
    margin: 0;
  }
  .code-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-md);
    padding: var(--space-sm);
  }
  .code-notes {
    display: grid;
    gap: var(--space-xs);
  }
  .example-code-panel {
    margin-bottom: 0;
  }
  .code-disclosure {
    margin-top: var(--space-lg);
    border: 0.0625rem solid var(--color-border-soft);
    border-radius: var(--radius-panel);
    padding: var(--space-xs);
  }
</style>
