---
interface Props {
  version?: string
  license?: string
  href?: string
}
const { version, license, href = '#top' } = Astro.props
---

<a
  href={href}
  class:list={['flex items-center gap-2.5 text-sm font-medium tracking-tight']}
  aria-label="@samline/ticker home"
>
  <span class:list={['dot-mark']} aria-hidden="true"></span>
  <span class:list={['logo-name font-mono text-[0.95rem]']}>@samline/ticker</span>
  {version && (
    <span
      class:list={[
        'ml-1 hidden rounded-full border-[0.0625rem] border-border bg-surface px-2 py-0.5 font-mono text-[0.65rem] text-text-muted sm:inline-block',
      ]}
    >
      v{version}
    </span>
  )}
  {license && (
    <>
      <span class:list={['text-text-subtle']} aria-hidden="true">
        ·
      </span>
      <span class:list={['text-text-subtle']}>{license}</span>
    </>
  )}
</a>

<style>
  .dot-mark {
    width: 0.875rem;
    height: 0.875rem;
    border-radius: 624.9375rem;
    background: var(--color-accent);
    display: inline-block;
    box-shadow:
      0 0 0 0.25rem rgba(183, 174, 210, 0.18),
      0 0 1rem var(--color-accent-glow);
  }
  @media (width < 37.5rem) {
    .logo-name {
      font-size: 0.8rem;
    }
  }

  .dot-mark {
    width: 0.6875rem;
    height: 0.6875rem;
    box-shadow: none;
  }

  .dot-mark {
    width: 0.6875rem;
    height: 0.6875rem;
    box-shadow: none;
  }
  @media (width < 23.4375rem) {
    .logo-name {
      font-size: 0.72rem;
    }
  }
  :focus-visible {
    outline: 0.125rem solid var(--color-accent);
    outline-offset: 0.25rem;
  }
  @media (prefers-reduced-motion: reduce) {
    :where(a, button, summary) {
      transition: none;
    }
  }
</style>
