---
import RangeControl from '../../../shared/components/RangeControl.astro'
import { format } from '../../../shared/i18n/format'
import { getI18n } from '../i18n/utils'
const i18n = getI18n(Astro)
const t = i18n.controls.speed
---

<ticker-speed data-display-template={t.display} data-description-template={t.description}>
  <RangeControl
    label={t.label}
    min="14"
    max="60"
    value="38"
    step="1"
    disabled
    aria-label={t.ariaLabel}
  >
    <output aria-live="off">{format(t.display, { seconds: 38 })}</output>
  </RangeControl>
</ticker-speed>

<script>
  import { mountElements } from '../../../shared/lib/mount-elements'
  import { syncSpeedControl } from '../lib/speed-control'

  mountElements('ticker-speed', element => {
    const lifecycle = new AbortController()
    const input = element.querySelector<HTMLInputElement>('input')
    input?.addEventListener('input', () => syncSpeedControl(element, Number(input.value)), {
      signal: lifecycle.signal,
    })
    // The owning demo supplies its duration and enables the input.
    syncSpeedControl(element, input?.disabled ? undefined : Number(input?.value))
    return () => lifecycle.abort()
  })
</script>

<style>
  ticker-speed output {
    color: var(--color-text);
    width: 3ch;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }
  ticker-speed {
    display: block;
  }
</style>
