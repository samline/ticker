<ticker-speed>
  <label class:list={['speed-control']}>
    Loop duration
    <input
      type="range"
      min="14"
      max="60"
      value="38"
      step="1"
      data-speed=""
      disabled=""
      aria-label="Demo loop duration in seconds"
    />
    <output data-speed-output="">38s</output>
  </label>
</ticker-speed>

<script>
  class TickerSpeed extends HTMLElement {
    private lifecycle?: AbortController
    connectedCallback() {
      this.lifecycle?.abort()
      this.lifecycle = new AbortController()
      const { signal } = this.lifecycle
      const input = this.querySelector<HTMLInputElement>('input')
      const output = this.querySelector<HTMLOutputElement>('output')
      if (!input || !output) return
      input.id ||= `speed-${crypto.randomUUID()}`
      output.htmlFor = input.id
      const display = () => {
        output.value = `${input.value}s`
        input.setAttribute('aria-valuetext', `${input.value} seconds per loop`)
      }
      this.addEventListener(
        'speed:set',
        event => {
          const { duration, enabled } = (
            event as CustomEvent<{ duration: number; enabled: boolean }>
          ).detail
          input.disabled = !enabled
          input.value = String(duration)
          display()
        },
        { signal }
      )
      input.addEventListener(
        'input',
        () => {
          display()
          this.dispatchEvent(
            new CustomEvent('speed:change', { bubbles: true, detail: Number(input.value) })
          )
        },
        { signal }
      )
      display()
    }
    disconnectedCallback() {
      this.lifecycle?.abort()
    }
  }
  if (!customElements.get('ticker-speed')) customElements.define('ticker-speed', TickerSpeed)
</script>
<style>
  .speed-control {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.65rem;
    white-space: nowrap;
  }
  .speed-control input {
    accent-color: var(--color-accent);
    width: 7rem;
    cursor: pointer;
  }
  .speed-control output {
    color: var(--color-text);
    width: 3ch;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }
  @media (width < 48rem) {
    .speed-control {
      width: 100%;
    }
  }
  @media (width < 48rem) {
    .speed-control input {
      flex: 1;
      min-width: 3.75rem;
    }
  }
  ticker-speed {
    display: block;
  }
</style>
