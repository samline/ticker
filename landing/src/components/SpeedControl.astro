---
import RangeControl from '../../../shared/components/RangeControl.astro'
import { format } from '../../../shared/i18n/format'
import { getI18n } from '../i18n/utils'
const i18n = getI18n(Astro)
const t = i18n.controls.speed
---

<ticker-speed data-display-template={t.display} data-description-template={t.description}>
  <RangeControl
    label={t.label}
    min="14"
    max="60"
    value="38"
    step="1"
    disabled
    aria-label={t.ariaLabel}
  >
    <output aria-live="off">{format(t.display, { seconds: 38 })}</output>
  </RangeControl>
</ticker-speed>

<script>
  class TickerSpeed extends HTMLElement {
    private lifecycle?: AbortController
    connectedCallback() {
      this.lifecycle?.abort()
      this.lifecycle = new AbortController()
      const { signal } = this.lifecycle
      const input = this.querySelector<HTMLInputElement>('input')
      const output = this.querySelector<HTMLOutputElement>('output')
      if (!input || !output) return
      input.id ||= `speed-${crypto.randomUUID()}`
      output.htmlFor = input.id
      const display = () => {
        output.value = (this.dataset.displayTemplate ?? '').replace('{seconds}', input.value)
        input.setAttribute(
          'aria-valuetext',
          (this.dataset.descriptionTemplate ?? '').replace('{seconds}', input.value)
        )
      }
      this.addEventListener(
        'speed:set',
        event => {
          const { duration, enabled } = (
            event as CustomEvent<{ duration: number; enabled: boolean }>
          ).detail
          input.disabled = !enabled
          input.value = String(duration)
          display()
        },
        { signal }
      )
      input.addEventListener(
        'input',
        () => {
          display()
          this.dispatchEvent(
            new CustomEvent('speed:change', { bubbles: true, detail: Number(input.value) })
          )
        },
        { signal }
      )
      display()
    }
    disconnectedCallback() {
      this.lifecycle?.abort()
    }
  }
  if (!customElements.get('ticker-speed')) customElements.define('ticker-speed', TickerSpeed)
</script>
<style>
  ticker-speed output {
    color: var(--color-text);
    width: 3ch;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }
  ticker-speed {
    display: block;
  }
</style>
