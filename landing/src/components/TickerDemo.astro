---
import { format } from '../../../shared/i18n/format'
import { getI18n } from '../i18n/utils'
import RangeControl from '../../../shared/components/RangeControl.astro'
import Button from '../../../shared/components/Button.astro'
interface Props {
  id?: string
  kind: 'news' | 'logos' | 'prices'
  label: string
  duration?: number
  direction?: import('../../../src/core/types').TickerDirection
  speed?: number
  autoplay?: boolean
  navigation?: boolean
  resumeAfterDrag?: boolean
  rtl?: boolean
  responsive?: import('../../../src/core/types').TickerResponsiveRule[]
}
const {
  id = 'ticker',
  kind,
  label,
  duration,
  direction,
  speed,
  autoplay = true,
  navigation = false,
  resumeAfterDrag = false,
  responsive = [],
  rtl = false,
} = Astro.props
const instanceId = `${id}-${crypto.randomUUID()}`
const defaults = {
  news: { duration: 38, direction: 'left' },
  logos: { duration: 48, direction: 'left' },
  prices: { duration: 34, direction: 'right' },
}
const i18n = getI18n(Astro)
---

<ticker-demo
  data-speed={speed}
  data-autoplay={String(autoplay)}
  data-navigation={String(navigation)}
  data-resume-after-drag={String(resumeAfterDrag)}
  data-responsive={JSON.stringify(responsive)}
  data-kind={kind}
  data-pause-text={i18n.controls.ticker.pause}
  data-play-text={i18n.controls.ticker.play}
  data-pause-label={format(i18n.controls.ticker.pauseLabel, { label })}
  data-play-label={format(i18n.controls.ticker.playLabel, { label })}
  data-duration={duration ?? defaults[kind].duration}
  data-direction={direction ?? defaults[kind].direction}
>
  <div
    class:list={['ticker-frame ticker-wrapper']}
    dir={rtl ? 'rtl' : undefined}
    id={instanceId}
    data-ticker={kind}
    role="region"
    aria-live="off"
    tabindex="0"
    aria-label={label}
  >
    <div class:list={['ticker-track']}>
      <div class:list={['ticker-content']}>
        <slot />
      </div>
    </div>
  </div>
  <div class:list={['ticker-controls']} hidden>
    {navigation && (
      <>
        <Button variant="ghost" context="ticker" data-previous aria-controls={instanceId}>
          {i18n.controls.ticker.previous}
        </Button>
        <Button variant="ghost" context="ticker" data-next aria-controls={instanceId}>
          {i18n.controls.ticker.next}
        </Button>
        <RangeControl
          label={i18n.controls.ticker.position}
          data-position
          min="0"
          max="1"
          value="0"
          aria-controls={instanceId}
        />
      </>
    )}
    <Button
      variant="ghost"
      context="ticker"
      data-pause
      aria-controls={instanceId}
      aria-label={format(i18n.controls.ticker.pauseLabel, { label })}
    >
      {i18n.controls.ticker.pause}
    </Button>
  </div>
</ticker-demo>

<script>
  import { ticker, type TickerInstance } from '../../../src/vanilla/index'
  class TickerDemoElement extends HTMLElement {
    private controller?: TickerInstance | null
    private lifecycle?: AbortController
    connectedCallback() {
      this.lifecycle?.abort()
      this.lifecycle = new AbortController()
      const { signal } = this.lifecycle
      const frame = this.querySelector<HTMLElement>('.ticker-frame')
      const controls = this.querySelector<HTMLElement>('.ticker-controls')
      const button = controls?.querySelector<HTMLButtonElement>('button[data-pause]')
      if (!frame || !controls || !button) return
      try {
        this.controller = ticker(frame, {
          duration: Number(this.dataset.duration),
          direction: this.dataset.direction as import('../../../src/core/types').TickerDirection,
          speed: Number(this.dataset.speed),
          autoplay: this.dataset.autoplay !== 'false',
          navigation: this.dataset.navigation === 'true',
          resumeAfterDrag: this.dataset.resumeAfterDrag === 'true',
          responsive: JSON.parse(this.dataset.responsive ?? '[]'),
          pauseOnHover: true,
        })
        if (!this.controller) return
        if (this.dataset.navigation === 'true')
          this.controller.connectControls({
            previous: controls.querySelector<HTMLButtonElement>('[data-previous]')!,
            next: controls.querySelector<HTMLButtonElement>('[data-next]')!,
            rail: controls.querySelector<HTMLInputElement>('[data-position]')!,
          })
        // DOM measurements are returned as pixels by the library. Keep this
        // component's animation distance in rem without changing the library API.
        const normalizeDistance = () => {
          const distance = frame.style.getPropertyValue('--ticker-distance').trim()
          if (!distance.endsWith('px')) return
          const rootSize = Number.parseFloat(getComputedStyle(document.documentElement).fontSize)
          frame.style.setProperty(
            '--ticker-distance',
            `${Number.parseFloat(distance) / rootSize}rem`
          )
        }
        const measurements = new MutationObserver(normalizeDistance)
        measurements.observe(frame, { attributes: true, attributeFilter: ['style'] })
        signal.addEventListener('abort', () => measurements.disconnect(), { once: true })
        normalizeDistance()
        controls.hidden = false
        const renderPaused = (paused: boolean) => {
          frame.dataset.userPaused = String(paused)
          button.textContent = (paused ? this.dataset.playText : this.dataset.pauseText) ?? ''
          button.setAttribute(
            'aria-label',
            (paused ? this.dataset.playLabel : this.dataset.pauseLabel) ?? ''
          )
        }
        renderPaused(!this.controller.state.requested)
        this.controller.on('playback', state => renderPaused(!state.requested))
        button.addEventListener(
          'click',
          () => {
            if (this.controller?.state.requested) this.controller.pause()
            else this.controller?.play()
          },
          { signal }
        )
        this.addEventListener(
          'ticker:duration',
          event => {
            const duration = (event as CustomEvent<number>).detail
            this.dataset.duration = String(duration)
            this.controller?.update({ duration })
          },
          { signal }
        )
        this.addEventListener(
          'ticker:direction',
          event => {
            const direction = (event as CustomEvent<'left' | 'right' | 'up' | 'down'>).detail
            this.dataset.direction = direction
            this.controller?.update({ direction })
          },
          { signal }
        )
        const contentItems = () =>
          Array.from(
            this.controller?.source.querySelectorAll<HTMLElement>(
              '.ticker-content:not(.ticker-clone) [data-example-item]'
            ) ?? []
          )
        const reportItems = () =>
          this.dispatchEvent(
            new CustomEvent('ticker:items', {
              bubbles: true,
              detail: contentItems().map(item => ({
                id: item.dataset.exampleItem!,
                label: item.textContent ?? '',
              })),
            })
          )
        this.addEventListener('ticker:list', reportItems, { signal })
        this.addEventListener(
          'ticker:remove',
          event => {
            const id = (event as CustomEvent<string>).detail
            const item = contentItems().find(item => item.dataset.exampleItem === id)
            if (!item) return
            const separator = item.nextElementSibling
            if (separator?.classList.contains('sep')) separator.remove()
            item.remove()
            this.controller?.refresh()
            reportItems()
          },
          { signal }
        )
        this.addEventListener(
          'ticker:append',
          event => {
            if (!this.controller) return
            const item = document.createElement('span')
            item.textContent = (event as CustomEvent<string>).detail
            item.dataset.exampleItem = crypto.randomUUID()
            const separator = document.createElement('span')
            separator.className = 'sep'
            separator.setAttribute('aria-hidden', 'true')
            const content = this.controller.source.querySelector<HTMLElement>(
              '.ticker-content:not(.ticker-clone)'
            )
            content?.append(item, separator)
            this.controller.refresh()
            reportItems()
          },
          { signal }
        )
        this.addEventListener('ticker:refresh', () => this.controller?.refresh(), { signal })
        document.fonts?.ready
          .then(() => {
            if (!signal.aborted) this.controller?.refresh()
          })
          .catch(() => {})
        this.dataset.initialized = 'true'
        this.dispatchEvent(new CustomEvent('ticker:ready', { bubbles: true }))
      } catch (error) {
        frame.dataset.static = 'true'
        console.error('[ticker-demo] Failed to initialize', error)
      }
    }
    disconnectedCallback() {
      this.lifecycle?.abort()
      this.controller?.destroy()
      this.controller = undefined
      delete this.dataset.initialized
    }
  }
  if (!customElements.get('ticker-demo')) customElements.define('ticker-demo', TickerDemoElement)
</script>
<style>
  .ticker-wrapper {
    --ticker-distance: 0rem;
    --ticker-duration: 20s;
    width: 100%;
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .ticker-track {
    display: flex;
    width: max-content;
    direction: ltr;
    justify-self: left;
    transform: translate3d(0, 0, 0);
  }

  .ticker-track > * {
    display: flex;
    flex: 0 0 auto;
    min-width: max-content;
  }

  .ticker-clone {
    user-select: none;
  }

  .ticker-wrapper:not([data-interactive-clones='true']) .ticker-clone {
    pointer-events: none;
  }

  .ticker-wrapper[data-ready='true'][data-playing='true'] .ticker-track {
    will-change: transform;
  }

  .ticker-wrapper[data-ready='false'] .ticker-track {
    animation: none !important;
  }

  .ticker-wrapper[data-motion-direction='left'] .ticker-track {
    animation: ticker-left var(--ticker-duration) linear infinite;
  }

  .ticker-wrapper[data-motion-direction='right'] .ticker-track {
    animation: ticker-right var(--ticker-duration) linear infinite;
  }

  @keyframes ticker-left {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(calc(-1 * var(--ticker-distance)), 0, 0);
    }
  }

  @keyframes ticker-right {
    0% {
      transform: translate3d(calc(-1 * var(--ticker-distance)), 0, 0);
    }
    100% {
      transform: translate3d(0, 0, 0);
    }
  }

  .ticker-wrapper[data-writing-direction='rtl'] .ticker-track > * {
    direction: rtl;
  }

  .ticker-wrapper[data-axis='vertical'] .ticker-track {
    flex-direction: column;
    width: 100%;
    height: max-content;
  }

  .ticker-wrapper[data-axis='vertical'] .ticker-track > * {
    flex-direction: column;
    min-width: 0;
    width: 100%;
  }

  .ticker-wrapper[data-motion-direction='up'] .ticker-track {
    animation: ticker-up var(--ticker-duration) linear infinite;
  }

  .ticker-wrapper[data-motion-direction='down'] .ticker-track {
    animation: ticker-down var(--ticker-duration) linear infinite;
  }

  /* Pause declarations must follow every animation shorthand. */
  .ticker-wrapper:not([data-playing='true']) .ticker-track {
    animation-play-state: paused;
  }

  .ticker-wrapper[data-navigation='true'] {
    touch-action: pan-y;
  }

  .ticker-wrapper[data-navigation='true'][data-axis='vertical'] {
    touch-action: pan-x;
  }

  @keyframes ticker-up {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(0, calc(-1 * var(--ticker-distance)), 0);
    }
  }

  @keyframes ticker-down {
    from {
      transform: translate3d(0, calc(-1 * var(--ticker-distance)), 0);
    }
    to {
      transform: translate3d(0, 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker-track {
      animation: none !important;
      transform: none !important;
      will-change: auto !important;
    }

    .ticker-wrapper:not([data-navigation='true']) .ticker-clone {
      display: none;
    }

    .ticker-wrapper[data-navigation='true'] .ticker-track {
      transform: translate3d(var(--ticker-position, 0rem), 0, 0) !important;
    }

    .ticker-wrapper[data-navigation='true'][data-axis='vertical'] .ticker-track {
      transform: translate3d(0, var(--ticker-position, 0rem), 0) !important;
    }
  }

  .ticker-frame[data-axis='vertical'] {
    height: 22rem;
  }
  .ticker-frame[data-axis='vertical'] .ticker-content {
    align-items: stretch;
  }
  .ticker-frame[data-axis='vertical'] .ticker-track {
    --demo-item-gap: var(--space-md);
    padding-block: var(--space-xs);
    white-space: normal;
  }
  .ticker-frame[data-axis='vertical']::before,
  .ticker-frame[data-axis='vertical']::after {
    display: none;
  }
  .ticker-frame {
    position: relative;
    background: transparent;
    border: 0;
    border-radius: 0;
    overflow: hidden;
  }
  .ticker-frame::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1.5rem;
    z-index: 2;
    pointer-events: none;
  }
  .ticker-frame::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1.5rem;
    z-index: 2;
    pointer-events: none;
  }
  .ticker-frame::before {
    left: 0;
    background: linear-gradient(to right, var(--palette-specimen-surface), transparent);
  }
  .ticker-frame::after {
    right: 0;
    background: linear-gradient(to left, var(--palette-specimen-surface), transparent);
  }

  .ticker-track {
    --demo-item-gap: 2.5rem;
    align-items: center;
    gap: var(--demo-item-gap);
    padding: 1.0625rem 0;
    font-size: 1.03rem;
    color: var(--palette-ticker-text);
    white-space: nowrap;
  }

  .ticker-content {
    display: flex;
    align-items: center;
    gap: var(--demo-item-gap, 2.5rem);
  }

  .ticker-track :global(.sep) {
    width: 0.25rem;
    height: 0.25rem;
    border-radius: 624.9375rem;
    background: var(--palette-separator);
    flex: none;
  }

  .ticker-track :global(a:hover) {
    color: var(--palette-lavender);
  }

  .ticker-track :global(.price) {
    font-variant-numeric: tabular-nums;
    color: var(--palette-price-text);
  }
  .ticker-track :global(.delta-up) {
    color: var(--palette-price-up);
  }
  .ticker-track :global(.delta-down) {
    color: var(--palette-price-down);
  }

  .ticker-frame:not([data-ready='true']) {
    overflow-x: auto;
  }
  .ticker-frame[data-static='true'] {
    overflow-x: auto;
  }
  .ticker-frame:not([data-ready='true'])::before {
    display: none;
  }
  .ticker-frame:not([data-ready='true'])::after {
    display: none;
  }
  .ticker-frame[data-static='true']::before {
    display: none;
  }
  .ticker-frame[data-static='true']::after {
    display: none;
  }
  .ticker-frame[data-static='true'] .ticker-track {
    animation: none;
  }
  .ticker-controls {
    display: flex;
    justify-content: flex-end;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
    margin-top: 0.625rem;
  }
  .ticker-controls button {
    min-height: 2.75rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .ticker-frame {
      overflow-x: auto;
    }
    .ticker-frame::before {
      display: none;
    }
    .ticker-frame::after {
      display: none;
    }
    .ticker-controls {
      display: none;
    }
  }
  @media (width < 48rem) {
    .ticker-track {
      font-size: 0.9rem;
    }
  }
  .ticker-wrapper[data-ticker='logos'] .ticker-track {
    --demo-item-gap: 1.125rem;
    padding-block: 0.1875rem;
  }
  ticker-demo {
    display: block;
  }
  .ticker-controls[hidden] {
    display: none;
  }
  .ticker-content :global(a:focus-visible) {
    outline: 0.125rem solid var(--color-accent);
    outline-offset: 0.25rem;
  }
</style>
