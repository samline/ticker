---
import { format } from '../../../shared/i18n/format'
import { getI18n } from '../i18n/utils'
import RangeControl from '../../../shared/components/RangeControl.astro'
import Button from '../../../shared/components/Button.astro'
interface Props {
  id?: string
  kind: 'news' | 'logos' | 'prices'
  label: string
  duration?: number
  direction?: import('@samline/ticker').TickerDirection
  featuredPosition?: import('@samline/ticker').TickerFeaturedPosition
  speed?: number
  autoplay?: boolean
  interactiveClones?: boolean
  pauseOnHover?: boolean
  navigation?: boolean
  preserveNavigationPlayback?: boolean
  resumeAfterDrag?: boolean
  rtl?: boolean
  responsive?: import('@samline/ticker').TickerResponsiveRule[]
}
const {
  id = 'ticker',
  kind,
  label,
  duration,
  direction,
  speed,
  featuredPosition = 'center',
  autoplay = true,
  interactiveClones = false,
  pauseOnHover = true,
  navigation = false,
  preserveNavigationPlayback = false,
  resumeAfterDrag = false,
  responsive = [],
  rtl = false,
} = Astro.props
const instanceId = `${id}-${crypto.randomUUID()}`
const defaults = {
  news: { duration: 38, direction: 'left' },
  logos: { duration: 48, direction: 'left' },
  prices: { duration: 34, direction: 'right' },
}
const i18n = getI18n(Astro)
---

<ticker-demo
  data-featured-position={featuredPosition}
  data-speed={speed}
  data-autoplay={String(autoplay)}
  data-interactive-clones={String(interactiveClones)}
  data-pause-on-hover={String(pauseOnHover)}
  data-paused-focus={i18n.controls.ticker.pausedFocus}
  data-paused-hover={i18n.controls.ticker.pausedHover}
  data-navigation={String(navigation)}
  data-preserve-navigation-playback={String(preserveNavigationPlayback)}
  data-resume-after-drag={String(resumeAfterDrag)}
  data-responsive={JSON.stringify(responsive)}
  data-kind={kind}
  data-pause-text={i18n.controls.ticker.pause}
  data-play-text={i18n.controls.ticker.play}
  data-pause-label={format(i18n.controls.ticker.pauseLabel, { label })}
  data-play-label={format(i18n.controls.ticker.playLabel, { label })}
  data-duration={duration ?? defaults[kind].duration}
  data-direction={direction ?? defaults[kind].direction}
>
  <div
    class:list={['ticker-frame ticker-wrapper']}
    dir={rtl ? 'rtl' : undefined}
    id={instanceId}
    data-ticker={kind}
    role="region"
    aria-live="off"
    tabindex="0"
    aria-label={label}
  >
    <div class:list={['ticker-track']}>
      <div class:list={['ticker-content']}>
        <slot />
      </div>
    </div>
  </div>
  <div class:list={['ticker-controls']} inert>
    <span class:list={['playback-feedback']} role="status" aria-live="polite">
      <span aria-hidden="true">{i18n.controls.ticker.pausedFocus}</span>
      <span aria-hidden="true">{i18n.controls.ticker.pausedHover}</span>
      <span data-playback-status></span>
    </span>
    {navigation && (
      <>
        <Button variant="ghost" context="ticker" data-previous aria-controls={instanceId}>
          {i18n.controls.ticker.previous}
        </Button>
        <Button variant="ghost" context="ticker" data-next aria-controls={instanceId}>
          {i18n.controls.ticker.next}
        </Button>
        <RangeControl
          label={i18n.controls.ticker.position}
          data-position
          min="0"
          max="1"
          value="0"
          aria-controls={instanceId}
        />
      </>
    )}
    <Button
      variant="ghost"
      context="ticker"
      data-pause
      aria-controls={instanceId}
      aria-label={format(i18n.controls.ticker.pauseLabel, { label })}
    >
      {i18n.controls.ticker.pause}
    </Button>
  </div>
</ticker-demo>

<script>
  import { mountElements } from '../../../shared/lib/mount-elements'

  import { ticker } from '@samline/ticker'
  import '@samline/ticker/style.css'
  import { demoControllers } from '../lib/demo-controller'
  mountElements('ticker-demo', element => {
    const lifecycle = new AbortController()
    const { signal } = lifecycle
    const frame = element.querySelector<HTMLElement>('.ticker-frame')
    const controls = element.querySelector<HTMLElement>('.ticker-controls')
    const button = controls?.querySelector<HTMLButtonElement>('button[data-pause]')
    if (!frame || !controls || !button) return
    try {
      const controller = ticker(frame, {
        duration: Number(element.dataset.duration),
        direction: element.dataset.direction as import('@samline/ticker').TickerDirection,
        speed: Number(element.dataset.speed),
        featuredPosition: element.dataset
          .featuredPosition as import('@samline/ticker').TickerFeaturedPosition,
        autoplay: element.dataset.autoplay !== 'false',
        interactiveClones: element.dataset.interactiveClones === 'true',
        navigation: element.dataset.navigation === 'true',
        resumeAfterDrag: element.dataset.resumeAfterDrag === 'true',
        responsive: JSON.parse(element.dataset.responsive ?? '[]'),
        pauseOnHover: element.dataset.pauseOnHover !== 'false',
      })
      if (!controller) return
      demoControllers.set(element, controller)
      if (element.dataset.navigation === 'true')
        controller.connectControls({
          itemsPerStep: 1,
          behavior: 'smooth',
          preservePlayback: element.dataset.preserveNavigationPlayback === 'true',
          previous: controls.querySelector<HTMLButtonElement>('[data-previous]')!,
          next: controls.querySelector<HTMLButtonElement>('[data-next]')!,
          rail: controls.querySelector<HTMLInputElement>('[data-position]')!,
        })
      controls.inert = false
      const status = controls.querySelector<HTMLElement>('[data-playback-status]')
      const renderPlayback = (state: import('@samline/ticker').TickerSnapshot) => {
        const paused = !state.requested
        if (status)
          status.textContent =
            state.requested && !state.playing
              ? state.reasons.includes('focus')
                ? (element.dataset.pausedFocus ?? '')
                : state.reasons.includes('hover')
                  ? (element.dataset.pausedHover ?? '')
                  : ''
              : ''
        frame.dataset.userPaused = String(paused)
        button.textContent = (paused ? element.dataset.playText : element.dataset.pauseText) ?? ''
        button.setAttribute(
          'aria-label',
          (paused ? element.dataset.playLabel : element.dataset.pauseLabel) ?? ''
        )
      }
      renderPlayback(controller.state)
      controller.on('playback', renderPlayback)
      button.addEventListener(
        'click',
        () => {
          if (controller.state.requested) controller.pause()
          else controller.play()
        },
        { signal }
      )
      document.fonts?.ready
        .then(() => {
          if (!signal.aborted) controller.refresh()
        })
        .catch(() => {})
      element.dataset.initialized = 'true'
      element.dispatchEvent(new CustomEvent('ticker:ready', { bubbles: true }))
      return () => {
        lifecycle.abort()
        controller.destroy()
        demoControllers.delete(element)
        controls.inert = true
        delete element.dataset.initialized
      }
    } catch (error) {
      lifecycle.abort()
      demoControllers.get(element)?.destroy()
      demoControllers.delete(element)
      frame.dataset.static = 'true'
      console.error('[ticker-demo] Failed to initialize', error)
    }
  })
</script>

<style>
  .ticker-frame[data-axis='vertical'] {
    white-space: normal;
    scroll-padding-inline: 0;
    height: 22rem;
  }
  .ticker-frame[data-axis='vertical'] .ticker-content {
    align-items: stretch;
  }
  .ticker-frame[data-axis='vertical'] .ticker-track {
    --demo-item-gap: var(--space-md);
    padding-block: var(--space-xs);
    white-space: normal;
  }
  .ticker-frame[data-axis='vertical']::before,
  .ticker-frame[data-axis='vertical']::after {
    display: none;
  }
  .ticker-frame {
    --ticker-edge-fade: 1.5rem;
    scroll-padding-inline: var(--ticker-edge-fade);
    position: relative;
    background: transparent;
    font-size: 1.03rem;
    color: var(--palette-ticker-text);
    white-space: nowrap;
    border: 0;
    border-radius: 0;
    overflow: hidden;
  }
  .ticker-frame :global(.ticker-featured) {
    z-index: 3;
    background: var(--palette-specimen-surface);
  }
  .ticker-frame :global(.ticker-featured > :focus-visible) {
    outline-offset: -0.1875rem;
  }
  .ticker-frame::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: var(--ticker-edge-fade);
    z-index: 2;
    pointer-events: none;
  }
  .ticker-frame::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: var(--ticker-edge-fade);
    z-index: 2;
    pointer-events: none;
  }
  .ticker-frame::before {
    left: 0;
    background: linear-gradient(to right, var(--palette-specimen-surface), transparent);
  }
  .ticker-frame::after {
    right: 0;
    background: linear-gradient(to left, var(--palette-specimen-surface), transparent);
  }

  .ticker-track {
    --demo-item-gap: 2.5rem;
    align-items: center;
    gap: var(--demo-item-gap);
    padding: 1.0625rem 0;
  }

  .ticker-content {
    display: flex;
    align-items: center;
    gap: var(--demo-item-gap, 2.5rem);
  }

  .ticker-track :global(.sep) {
    width: 0.25rem;
    height: 0.25rem;
    border-radius: 624.9375rem;
    background: var(--palette-separator);
    flex: none;
  }

  .ticker-track :global(a:hover) {
    color: var(--palette-lavender);
  }

  .ticker-track :global(.price) {
    font-variant-numeric: tabular-nums;
    color: var(--palette-price-text);
  }
  .ticker-track :global(.delta-up) {
    color: var(--palette-price-up);
  }
  .ticker-track :global(.delta-down) {
    color: var(--palette-price-down);
  }

  .ticker-frame:not([data-ready='true']) {
    overflow-x: auto;
  }
  .ticker-frame[data-static='true'] {
    overflow-x: auto;
  }
  .ticker-frame:not([data-ready='true'])::before {
    display: none;
  }
  .ticker-frame:not([data-ready='true'])::after {
    display: none;
  }
  .ticker-frame[data-static='true']::before {
    display: none;
  }
  .ticker-frame[data-static='true']::after {
    display: none;
  }
  .ticker-frame[data-static='true'] .ticker-track {
    animation: none;
  }
  .ticker-controls {
    display: flex;
    justify-content: flex-end;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
    margin-top: 0.625rem;
  }
  .playback-feedback {
    display: grid;
    flex-basis: 100%;
    font-size: var(--text-small);
    color: var(--color-text-muted);
    margin-inline-end: auto;
    max-width: 100%;
  }
  .playback-feedback > span {
    grid-area: 1 / 1;
  }
  .playback-feedback > [aria-hidden] {
    visibility: hidden;
  }
  .ticker-controls button {
    min-height: 2.75rem;
  }
  .ticker-controls[inert] {
    visibility: hidden;
  }
  @media (prefers-reduced-motion: reduce) {
    .ticker-frame {
      overflow-x: auto;
    }
    .ticker-frame::before {
      display: none;
    }
    .ticker-frame::after {
      display: none;
    }
    .ticker-controls {
      display: none;
    }
  }
  @media (width < 48rem) {
    .ticker-frame {
      font-size: 0.9rem;
    }
  }
  .ticker-wrapper[data-ticker='logos'] .ticker-track {
    --demo-item-gap: 1.125rem;
    padding-block: 0.1875rem;
  }
  ticker-demo {
    display: block;
  }
  .ticker-frame :global(a:focus-visible) {
    outline: 0.125rem solid var(--color-accent);
    outline-offset: 0.25rem;
  }
</style>
