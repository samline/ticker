{
  "name": "@samline/ticker",
  "version": "2.3.0",
  "packageManager": "bun@1.3.14",
  "description": "An accessible, dependency-free ticker (marquee) for vanilla JavaScript, TypeScript, and plain HTML.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": [
    "./dist/browser/global.global.js",
    "./dist/style.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.cjs"
    },
    "./vanilla": {
      "types": "./dist/vanilla/index.d.ts",
      "import": "./dist/vanilla/index.js",
      "require": "./dist/vanilla/index.cjs"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js",
      "require": "./dist/browser/index.cjs"
    },
    "./browser/global": {
      "default": "./dist/browser/global.global.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "clean": "rm -rf dist coverage",
    "typecheck": "tsc --noEmit",
    "build": "tsup --config tsup.config.ts",
    "dev": "tsup --config tsup.config.ts --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:package": "node scripts/test-package.mjs",
    "test:watch": "vitest",
    "docs:dev": "npm --prefix docs run dev",
    "docs:build": "npm --prefix docs run build",
    "docs:check": "npm --prefix docs run check",
    "prepublishOnly": "bun run clean && bun run build && bun run typecheck && bun run test:coverage && bun run test:package && npm pack --dry-run",
    "landing:build": "npm --prefix landing run build",
    "landing:dev": "npm --prefix landing run dev -- --host 127.0.0.1",
    "landing:check": "npm --prefix landing run check",
    "landing:preview": "npm --prefix landing run preview -- --host 127.0.0.1",
    "site:assets": "node scripts/site-assets.mjs",
    "site:build": "npm run site:assets && npm run docs:build && npm run landing:build && node landing/scripts/check-site.mjs --docs",
    "docs:test:browser": "npm --prefix docs run test:browser",
    "site:test:browser": "npm --prefix docs run test:combined"
  },
  "keywords": [
    "ticker",
    "marquee",
    "typescript",
    "html",
    "vanilla-js",
    "browser"
  ],
  "author": "Samuel Olvera (samline)",
  "license": "MIT",
  "homepage": "https://samline.github.io/ticker",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samline/ticker.git"
  },
  "bugs": {
    "url": "https://github.com/samline/ticker/issues"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.23",
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "@vitest/coverage-v8": "^5.0.1",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^5.0.1"
  }
}
