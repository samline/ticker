{
  "name": "ticker-docs",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/check-coverage.mjs && astro build && pagefind --site dist && node scripts/check-site.mjs",
    "preview": "astro preview",
    "check": "astro check && node scripts/check-coverage.mjs",
    "format": "prettier --plugin prettier-plugin-astro --config ../.prettierrc.cjs --write . ../shared",
    "format:check": "prettier --plugin prettier-plugin-astro --config ../.prettierrc.cjs --check . ../shared",
    "test:browser": "playwright test",
    "test:combined": "playwright test --config playwright.combined.config.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/sitemap": "^3.7.4",
    "@samline/drawer": "5.0.2",
    "@tailwindcss/vite": "4.3.0",
    "astro": "^7.3.8",
    "tailwindcss": "4.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@playwright/test": "1.62.1",
    "axe-core": "^4.14.0",
    "pagefind": "^1.4.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^5.9.3"
  }
}
