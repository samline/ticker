---
import Eyebrow from '../../../shared/components/Eyebrow.astro'
import { getI18n } from '../i18n/utils'
const t = getI18n(Astro)
import { href } from '../lib/routes'
interface Props {
  title: string
  description: string
  current: string
}
const { title, description, current } = Astro.props
const packageSeparator = current === 'index' ? title.lastIndexOf('/') : -1
---

<nav class:list={['breadcrumb']} aria-label={t.breadcrumbLabel} data-pagefind-ignore>
  <ol>
    <li>
      {current === 'index' ? (
        <span aria-current="page">{t.breadcrumb}</span>
      ) : (
        <a href={href('index')}>{t.breadcrumb}</a>
      )}
    </li>
    {current !== 'index' && (
      <li>
        <span aria-hidden="true">/</span>
        <span class:list={['section-name']} aria-current="page">
          {title}
        </span>
      </li>
    )}
  </ol>
</nav>
<header class:list={['article-heading']}>
  <Eyebrow class:list={['article-eyebrow']}>
    {current.startsWith('reference') ? t.apiReading : t.reading}
  </Eyebrow>
  <h1
    id="article-title"
    class:list={[{ 'package-title': packageSeparator !== -1 }]}
    data-pagefind-meta="title"
  >
    {packageSeparator !== -1 ? (
      <>
        {title.slice(0, packageSeparator + 1)}
        <span class:list={['package-name']}>{title.slice(packageSeparator + 1)}</span>
      </>
    ) : (
      title
    )}
  </h1>
  <p class:list={['description']}>{description}</p>
</header>

<style>
  .breadcrumb {
    font-size: 0.6875rem;
    color: var(--color-text-subtle);
    margin-bottom: var(--space-xl);
  }
  .breadcrumb ol,
  .breadcrumb li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.625rem;
  }
  .breadcrumb ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .breadcrumb a {
    color: inherit;
    text-decoration: none;
  }
  .article-eyebrow {
    margin-bottom: 0.875rem;
  }
  .section-name {
    color: var(--palette-heading-accent);
  }
  .article-heading {
    padding-bottom: var(--space-xl);
    margin-bottom: var(--space-xl);
    border-bottom: 0.0625rem solid var(--color-border-soft);
  }
  h1 {
    line-height: 1.1;
    overflow-wrap: anywhere;
    margin: 0 0 var(--space-md);
    font-family: var(--font-serif);
    font-weight: 400;
    font-style: italic;
    color: var(--palette-heading-accent);
    font-size: clamp(2.75rem, 5vw, 4rem);
    letter-spacing: -0.025em;
  }
  .package-title {
    font-family: var(--font-sans);
    font-weight: 500;
    font-style: normal;
    color: var(--color-text);
  }
  .package-name {
    font-family: var(--font-serif);
    font-weight: 400;
    font-style: italic;
    color: var(--palette-heading-accent);
  }
  .description {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-text-muted);
    margin: 0;
  }
  :focus-visible {
    outline: 0.125rem solid var(--color-accent);
    outline-offset: 0.1875rem;
  }
  a {
    transition:
      color var(--duration-ui) var(--ease-ui),
      background-color var(--duration-ui) var(--ease-ui),
      border-color var(--duration-ui) var(--ease-ui);
  }
  @media (prefers-reduced-motion: reduce) {
    a {
      transition: none;
    }
  }
</style>
