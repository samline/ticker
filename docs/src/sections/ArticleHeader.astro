---
import Eyebrow from '../../../shared/components/Eyebrow.astro'
import { getI18n } from '../i18n/utils'
const t = getI18n(Astro)
import { getNavigation } from '../lib/navigation'
import { href } from '../lib/routes'
interface Props {
  title: string
  description: string
  current: string
}
const { title, description, current } = Astro.props
const groups = await getNavigation(Astro.currentLocale)
const section = groups.find(group => group.pages.some(([id]) => id === current))?.label ?? t.docs
---

<div class:list={['breadcrumb']} data-pagefind-ignore>
  <a href={href('index')}>{t.breadcrumb}</a>
  <span aria-hidden="true">/</span>
  <span class:list={['section-name']}>{section}</span>
</div>
<header class:list={['article-heading']}>
  <Eyebrow class:list={['article-eyebrow']}>
    {current.startsWith('reference') ? t.apiReading : t.reading}
  </Eyebrow>
  <h1 data-pagefind-meta="title">{title}</h1>
  <p class:list={['description']}>{description}</p>
</header>

<style>
  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    font-size: 0.6875rem;
    color: var(--color-text-subtle);
    margin-bottom: var(--space-xl);
  }
  .breadcrumb a {
    color: inherit;
    text-decoration: none;
  }
  .article-eyebrow {
    margin-bottom: 0.875rem;
  }
  .section-name {
    color: var(--palette-heading-accent);
  }
  .article-heading {
    padding-bottom: var(--space-xl);
    margin-bottom: var(--space-xl);
    border-bottom: 0.0625rem solid var(--color-border-soft);
  }
  h1 {
    line-height: 1.1;
    overflow-wrap: anywhere;
    margin: 0 0 var(--space-md);
    font-family: var(--font-serif);
    font-weight: 400;
    font-style: italic;
    color: var(--palette-heading-accent);
    font-size: clamp(2.75rem, 5vw, 4rem);
    letter-spacing: -0.025em;
  }
  .description {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-text-muted);
    margin: 0;
  }
  :focus-visible {
    outline: 0.125rem solid var(--color-accent);
    outline-offset: 0.1875rem;
  }
  a {
    transition:
      color var(--duration-ui) var(--ease-ui),
      background-color var(--duration-ui) var(--ease-ui),
      border-color var(--duration-ui) var(--ease-ui);
  }
  @media (prefers-reduced-motion: reduce) {
    a {
      transition: none;
    }
  }
</style>
