---
import { getI18n, getLocale } from '../i18n/utils'
import { href } from '../lib/routes'
import manifest from '../../../package.json'
import { serializeJsonLd } from '../../../shared/lib/serialize'
interface Props {
  title: string
  description: string
  current: string
}
const { title, description, current } = Astro.props
const t = getI18n(Astro)
const canonical = new URL(href(current), Astro.site).href
const landingUrl = new URL('../', new URL(import.meta.env.BASE_URL, Astro.site))
const socialImage = new URL('social.png', landingUrl).href
const locale = getLocale(Astro.currentLocale)
const documentation = new URL(href('index'), Astro.site).href
const repository = manifest.repository.url.replace(/^git\+/, '').replace(/\.git$/, '')
const author = { '@type': 'Person', name: manifest.author }
const breadcrumb = {
  '@type': 'BreadcrumbList',
  '@id': `${canonical}#breadcrumb`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.docs, item: documentation },
    ...(current === 'index'
      ? []
      : [{ '@type': 'ListItem', position: 2, name: title, item: canonical }]),
  ],
}
const schema = serializeJsonLd({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'TechArticle',
      '@id': `${canonical}#article`,
      headline: title,
      description,
      url: canonical,
      mainEntityOfPage: { '@id': `${canonical}#webpage` },
      inLanguage: locale,
      author,
      publisher: author,
      image: { '@type': 'ImageObject', url: socialImage, width: 1200, height: 630 },
      isPartOf: {
        '@type': 'WebSite',
        '@id': `${landingUrl.href}#website`,
        url: landingUrl.href,
        name: manifest.name,
      },
      about: {
        '@type': 'SoftwareSourceCode',
        '@id': `${landingUrl.href}#software`,
        name: manifest.name,
        version: manifest.version,
        codeRepository: repository,
      },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      inLanguage: locale,
      isPartOf: { '@id': `${landingUrl.href}#website` },
      mainEntity: { '@id': `${canonical}#article` },
      breadcrumb: { '@id': breadcrumb['@id'] },
    },
    breadcrumb,
  ],
})
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{`${title} · ${t.titleSuffix}`}</title>
<meta name="description" content={description} />
<meta name="author" content={manifest.author} />
<meta name="keywords" content={[...manifest.keywords, ...t.metaKeywords].join(', ')} />
<meta name="theme-color" content="#1d1c23" />
<meta
  name="robots"
  content={
    import.meta.env.DEV
      ? 'noindex, nofollow'
      : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'
  }
/>
<meta name="color-scheme" content="light dark" />
<meta name="referrer" content="strict-origin-when-cross-origin" />
<link rel="canonical" href={canonical} />
<link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
<meta property="og:type" content="article" />
<meta property="og:title" content={`${title} · ${t.titleSuffix}`} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={t.name} />
<meta property="og:locale" content={t.socialLocale} />
<meta property="og:image" content={socialImage} />
<meta property="og:image:alt" content={t.socialImageAlt} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={`${title} · ${t.titleSuffix}`} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />
<meta name="twitter:image:alt" content={t.socialImageAlt} />
<script type="application/ld+json" set:html={schema} />
