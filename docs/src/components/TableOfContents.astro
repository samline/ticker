---
import type { MarkdownHeading } from 'astro'
import { getI18n } from '../i18n/utils'
const t = getI18n(Astro)
interface Props {
  headings: MarkdownHeading[]
  collapsed?: boolean
}
const { headings, collapsed = false } = Astro.props
const items = headings.filter((h) => h.depth === 2 || h.depth === 3)
---

{items.length > 0 && (
  <aside class:list={['toc']} aria-label={t.toc}>
    <details open={!collapsed}>
      <summary>{t.toc}</summary>
      <nav>
        <ul>
          {items.map((h) => (
            <li class:list={[{ nested: h.depth === 3 }]}>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ul>
      </nav>
    </details>
  </aside>
)}
<style>
  .toc {
    min-width: 0;
    font-size: 0.75rem;
  }
  summary {
    font-weight: 600;
    color: var(--color-text);
    cursor: pointer;
  }
  ul {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    border-left: 0.0625rem solid var(--color-border-soft);
    display: grid;
    gap: 0.375rem;
  }
  a {
    display: block;
    padding: 0.3125rem 0 0.3125rem 1rem;
    line-height: 1.55;
    color: var(--color-text-subtle);
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .nested a {
    padding-left: 1.75rem;
    font-size: 0.6875rem;
  }
  a:focus-visible {
    outline: 0.125rem solid var(--color-accent);
    outline-offset: 0.125rem;
  }
  @media (hover: hover) {
    a:hover {
      color: var(--color-accent);
    }
  }
  @media (width < 80rem) {
    details {
      border: 0.0625rem solid var(--color-border-soft);
      padding: 1rem;
      border-radius: 0.625rem;
    }
    details:not([open]) {
      margin: 0;
    }
  }
</style>
