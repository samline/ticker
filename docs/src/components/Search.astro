---
import { getI18n } from '../i18n/utils'
import TextField from './TextField.astro'
import SearchResultCard from './SearchResultCard.astro'
import Icon from './Icon.astro'
import Box from '../../../landing/src/components/Box.astro'
import Button from '../../../landing/src/components/Button.astro'
import DrawerStyles from './DrawerStyles.astro'
const s = getI18n(Astro).search
const id = `docs-search-${crypto.randomUUID()}`
---

<ticker-docs-search
  class:list={['search']}
  data-id={id}
  data-base={import.meta.env.BASE_URL}
  data-title={s.label}
  data-close={s.close}
  data-loading={s.loading}
  data-empty={s.empty}
  data-error={s.error}
  data-count={s.count}
>
  <Button
    variant="ghost"
    class:list={['search-trigger']}
    hidden
    aria-label={s.label}
    aria-haspopup="dialog"
    aria-expanded="false"
    data-search-trigger
  >
    <Icon name="search" />
    <span class:list={['search-label']}>{s.label}</span>
    <kbd aria-hidden="true">{s.hint}</kbd>
  </Button>
  <template>
    <div class:list={['search-content']} data-drawer-no-drag>
      <Box size="medium">
        <div class:list={['search-heading']}>
          <p>{s.label}</p>
          <span id={`${id}-hint`} class:list={['search-hint']}>
            {s.initial}
          </span>
        </div>
        <TextField
          label={s.label}
          id={`${id}-input`}
          type="text"
          role="searchbox"
          inputmode="search"
          placeholder={s.placeholder}
          autocomplete="off"
          aria-controls={`${id}-results`}
          aria-describedby={`${id}-hint`}
        />
        <p class:list={['search-status']} role="status" aria-live="polite"></p>
        <ul id={`${id}-results`} aria-label={s.results}></ul>
        <SearchResultCard />
      </Box>
    </div>
  </template>
</ticker-docs-search>
<script>
  import { browser } from '@samline/drawer/browser'
  type Result = {
    url: string
    meta: { title?: string }
    excerpt: string
    sub_results?: { url: string; title: string; excerpt: string }[]
  }
  type Pagefind = {
    options: (config: { baseUrl: string }) => Promise<void>
    search: (query: string) => Promise<{ results: { data: () => Promise<Result> }[] }>
  }
  class DocsSearch extends HTMLElement {
    private lifecycle?: AbortController
    private pagefind?: Promise<Pagefind>
    private request = 0
    private timer?: ReturnType<typeof setTimeout>
    connectedCallback() {
      this.lifecycle?.abort()
      this.lifecycle = new AbortController()
      const { signal } = this.lifecycle
      const trigger = this.querySelector<HTMLButtonElement>('[data-search-trigger]'),
        template = this.querySelector('template'),
        id = this.dataset.id
      if (!trigger || !template?.content.firstElementChild || !id) return
      const load = () => {
        if (!this.pagefind) {
          const base = (this.dataset.base ?? '/').replace(/\/$/, '') + '/'
          this.pagefind = import(
            /* @vite-ignore */ new URL(`${base}pagefind/pagefind.js`, location.origin).href
          )
            .then(async (module) => {
              const api = module as Pagefind
              await api.options({ baseUrl: base })
              return api
            })
            .catch((error) => {
              this.pagefind = undefined
              throw error
            })
        }
        return this.pagefind
      }
      const drawer = browser.newDrawer({
        id,
        html: template.content.firstElementChild.outerHTML,
        options: {
          container: this,
          triggerElement: trigger,
          direction: 'top',
          autoFocus: true,
          ariaLabel: this.dataset.title,
          contentClassName: 'docs-search-panel',
          overlayClassName: 'docs-search-overlay',
          closeButton: { icon: '×', className: 'docs-search-close', ariaLabel: this.dataset.close },
          onOpenChange: (open) => {
            trigger.setAttribute('aria-expanded', String(open))
            if (!open) {
              ++this.request
              clearTimeout(this.timer)
              return
            }
            load().catch(() => {
              if (!signal.aborted) {
                const status = this.querySelector('[role=status]')
                if (status) status.textContent = this.dataset.error ?? ''
              }
            })
          },
        },
      })
      trigger.hidden = false
      document.addEventListener(
        'keydown',
        (event) => {
          const activeSearch = document.activeElement?.closest('ticker-docs-search')
          if (event.defaultPrevented || (activeSearch && activeSearch !== this)) return
          if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
            event.preventDefault()
            drawer?.setOpen(trigger.getAttribute('aria-expanded') !== 'true')
          }
        },
        { signal }
      )
      this.addEventListener(
        'input',
        (event) => {
          if (!(event.target instanceof HTMLInputElement)) return
          const input = event.target,
            status = this.querySelector('[role=status]'),
            list = this.querySelector('ul')
          if (!status || !list) return
          clearTimeout(this.timer)
          const request = ++this.request
          list.replaceChildren()
          if (!input.value.trim()) {
            status.textContent = ''
            return
          }
          status.textContent = this.dataset.loading ?? ''
          this.timer = setTimeout(async () => {
            try {
              const api = await load(),
                found = await api.search(input.value.trim())
              const results = await Promise.all(
                found.results.slice(0, 12).map((result) => result.data())
              )
              if (signal.aborted || request !== this.request) return
              const cardTemplate = this.querySelector<HTMLTemplateElement>('[data-result-template]')
              if (!cardTemplate?.content.firstElementChild) return
              for (const result of results) {
                const li = document.createElement('li')
                const link = cardTemplate.content.firstElementChild.cloneNode(
                  true
                ) as HTMLAnchorElement
                const title = link.querySelector('[data-result-title]'),
                  excerpt = link.querySelector('[data-result-excerpt]'),
                  match = result.sub_results?.[0]
                link.href = match?.url ?? result.url
                if (title) title.textContent = result.meta.title ?? match?.title ?? ''
                if (excerpt)
                  excerpt.textContent =
                    new DOMParser().parseFromString(match?.excerpt ?? result.excerpt, 'text/html')
                      .body.textContent ?? ''
                li.append(link)
                list.append(li)
              }
              status.textContent = results.length
                ? (this.dataset.count ?? '')
                    .replace('{count}', String(found.results.length))
                    .replace('{shown}', String(results.length))
                : (this.dataset.empty ?? '')
            } catch {
              if (!signal.aborted && request === this.request)
                status.textContent = this.dataset.error ?? ''
            }
          }, 150)
        },
        { signal }
      )
      this.addEventListener(
        'click',
        (event) => {
          if (event.target instanceof Element && event.target.closest('.docs-search-panel a'))
            drawer?.setOpen(false)
        },
        { signal }
      )
    }
    disconnectedCallback() {
      this.lifecycle?.abort()
      clearTimeout(this.timer)
      ++this.request
      if (this.dataset.id) browser.destroyDrawer(this.dataset.id)
    }
  }
  if (!customElements.get('ticker-docs-search'))
    customElements.define('ticker-docs-search', DocsSearch)
</script>
<DrawerStyles scope="ticker-docs-search" />
<style>
  .search {
    display: block;
    flex: none;
    min-width: 0;
  }
  [hidden] {
    display: none !important;
  }
  .search-trigger {
    width: 2.5rem;
    padding: 0;
    gap: 0.625rem;
  }
  .search-label,
  kbd {
    display: none;
  }
  .search-content {
    min-width: 0;
    padding-block: 1.75rem;
  }
  .search-heading {
    padding-right: 3rem;
    margin-bottom: 1.5rem;
  }
  .search-heading p {
    font-size: 1.25rem;
    letter-spacing: -0.025em;
    font-weight: 500;
    margin: 0 0 0.5rem;
  }
  .search-hint {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }
  .search-status {
    font-size: 0.75rem;
    color: var(--color-text-subtle);
    margin: 1rem 0;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.625rem;
  }
  .search :global(.docs-search-panel) {
    position: fixed;
    inset: 0 0 auto;
    z-index: 101;
    width: 100%;
    max-height: min(44rem, calc(100dvh - 1rem));
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--color-bg);
    color: var(--color-text);
    border-bottom: 0.0625rem solid var(--color-border);
    border-radius: 0 0 1.25rem 1.25rem;
    box-shadow: 0 1rem 3rem rgb(0 0 0 / 0.2);
  }
  .search :global(.docs-search-overlay) {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: rgb(0 0 0 / 0.5);
  }
  .search :global(.docs-search-close) {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 0.0625rem solid var(--color-border);
    border-radius: 0.75rem;
    background: var(--color-surface);
    color: var(--color-text);
    font-size: 1.5rem;
    cursor: pointer;
    transition:
      color var(--duration-ui) var(--ease-ui),
      background-color var(--duration-ui) var(--ease-ui),
      border-color var(--duration-ui) var(--ease-ui);
  }
  .search :global(.docs-search-close:focus-visible) {
    outline: 0.125rem solid var(--color-accent);
    outline-offset: 0.1875rem;
  }
  @media (hover: hover) {
    .search :global(.docs-search-close:hover) {
      color: var(--color-accent);
      background: var(--color-accent-soft);
      border-color: var(--palette-border-hover);
    }
  }
  @media (width>=64rem) {
    .search-trigger {
      width: auto;
      padding-inline: 1rem;
    }
    .search-label,
    kbd {
      display: inline;
    }
    .search-label {
      font-size: 0.8125rem;
    }
    kbd {
      padding: 0.125rem 0.375rem;
      border: 0.0625rem solid var(--color-border-soft);
      border-radius: 0.25rem;
      font-family: var(--font-mono);
      font-size: 0.625rem;
      color: var(--color-text-subtle);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .search :global(.docs-search-close) {
      transition: none;
    }
    .search :global(.docs-search-panel),
    .search :global(.docs-search-overlay) {
      animation: none !important;
      transition: none !important;
    }
  }
</style>
