---
import { t } from '../i18n/en'
const id = `docs-search-${crypto.randomUUID()}`
const s = t.search
---

<ticker-docs-search
  class:list={['search']}
  data-base={import.meta.env.BASE_URL}
  data-loading={s.loading}
  data-empty={s.empty}
  data-error={s.error}
  data-count={s.count}
>
  <button
    class:list={['open']}
    type="button"
    hidden
    aria-label={s.label}
    aria-haspopup="dialog"
    aria-controls={id}
  >
    <span aria-hidden="true">⌕</span>
    <span class:list={['label']}>{s.label}</span>
    <kbd>{s.hint}</kbd>
  </button>
  <dialog id={id} aria-label={s.label}>
    <form method="dialog">
      <label for={`${id}-input`}>{s.label}</label>
      <button type="submit" aria-label={s.close}>
        ×
      </button>
    </form>
    <input
      id={`${id}-input`}
      type="text"
      role="searchbox"
      inputmode="search"
      placeholder={s.placeholder}
      autocomplete="off"
      autofocus
      aria-controls={`${id}-results`}
    />
    <p role="status" aria-live="polite">
      {s.initial}
    </p>
    <ul id={`${id}-results`} aria-label={s.results}></ul>
  </dialog>
</ticker-docs-search>
<script>
  type Result = {
    url: string
    meta: { title?: string }
    excerpt: string
    sub_results?: { url: string; title: string; excerpt: string }[]
  }
  type Pagefind = {
    options: (config: { baseUrl: string }) => Promise<void>
    search: (query: string) => Promise<{ results: { data: () => Promise<Result> }[] }>
  }
  class DocsSearch extends HTMLElement {
    private lifecycle?: AbortController
    private pagefind?: Promise<Pagefind>
    private request = 0
    private timer?: ReturnType<typeof setTimeout>
    connectedCallback() {
      this.lifecycle?.abort()
      this.lifecycle = new AbortController()
      const { signal } = this.lifecycle
      const button = this.querySelector<HTMLButtonElement>('.open'),
        dialog = this.querySelector('dialog'),
        input = this.querySelector('input'),
        status = this.querySelector('[role=status]'),
        list = this.querySelector('ul')
      if (!button || !dialog || !input || !status || !list) return
      const load = () => {
        if (!this.pagefind) {
          const base = (this.dataset.base ?? '/').replace(/\/$/, '') + '/'
          const url = new URL(`${base}pagefind/pagefind.js`, location.origin).href
          this.pagefind = import(/* @vite-ignore */ url)
            .then(async (module) => {
              const api = module as Pagefind
              await api.options({ baseUrl: base })
              return api
            })
            .catch((error) => {
              this.pagefind = undefined
              throw error
            })
        }
        return this.pagefind
      }
      const open = () => {
        if (!dialog.open) dialog.showModal()
        load().catch(() => {
          if (!signal.aborted) status.textContent = this.dataset.error ?? ''
        })
      }
      button.hidden = false
      button.addEventListener('click', open, { signal })
      document.addEventListener(
        'keydown',
        (event) => {
          if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
            event.preventDefault()
            if (dialog.open) dialog.close()
            else open()
          }
        },
        { signal }
      )
      const plain = (html: string) =>
        new DOMParser().parseFromString(html, 'text/html').body.textContent ?? ''
      input.addEventListener(
        'input',
        () => {
          clearTimeout(this.timer)
          const request = ++this.request
          list.replaceChildren()
          if (!input.value.trim()) {
            status.textContent = ''
            return
          }
          status.textContent = this.dataset.loading ?? ''
          this.timer = setTimeout(async () => {
            try {
              const api = await load(),
                found = await api.search(input.value.trim())
              const results = await Promise.all(
                found.results.slice(0, 12).map((result) => result.data())
              )
              if (signal.aborted || request !== this.request) return
              for (const result of results) {
                const li = document.createElement('li'),
                  a = document.createElement('a'),
                  title = document.createElement('strong'),
                  excerpt = document.createElement('span')
                const match = result.sub_results?.[0]
                a.href = match?.url ?? result.url
                title.textContent = result.meta.title ?? match?.title ?? ''
                excerpt.textContent = plain(match?.excerpt ?? result.excerpt)
                a.append(title, excerpt)
                li.append(a)
                list.append(li)
              }
              status.textContent = results.length
                ? (this.dataset.count ?? '').replace('{count}', String(found.results.length))
                : (this.dataset.empty ?? '')
            } catch {
              if (!signal.aborted && request === this.request)
                status.textContent = this.dataset.error ?? ''
            }
          }, 150)
        },
        { signal }
      )
      dialog.addEventListener(
        'close',
        () => {
          ++this.request
          clearTimeout(this.timer)
        },
        { signal }
      )
    }
    disconnectedCallback() {
      this.lifecycle?.abort()
      clearTimeout(this.timer)
      ++this.request
      this.querySelector('dialog')?.close()
    }
  }
  if (!customElements.get('ticker-docs-search'))
    customElements.define('ticker-docs-search', DocsSearch)
</script>
<style>
  .search {
    display: block;
    min-width: 0;
  }
  button {
    cursor: pointer;
  }
  .open {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.5rem;
    padding: 0.5rem 0.75rem;
    border: 0.0625rem solid var(--color-border-soft);
    border-radius: 0.625rem;
    background: var(--color-bg-soft);
    color: var(--color-text-muted);
    font-size: 0.75rem;
    transition: background-color var(--duration-ui) var(--ease-ui);
  }
  [hidden] {
    display: none !important;
  }
  kbd {
    font-size: 0.625rem;
    color: var(--color-text-subtle);
    font-family: var(--font-mono);
  }
  dialog {
    position: fixed;
    inset: 4rem 0 auto;
    width: min(40rem, calc(100% - 2rem));
    max-height: calc(100dvh - 6rem);
    overflow: auto;
    padding: 1.25rem;
    border: 0.0625rem solid var(--color-border);
    border-radius: 1rem;
    background: var(--color-bg);
    color: var(--color-text);
    box-shadow: 0 1rem 4rem rgb(0 0 0 / 0.3);
  }
  dialog::backdrop {
    background: rgb(0 0 0 / 0.6);
  }
  form {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
    font-size: 0.8125rem;
  }
  form button {
    min-width: 2.75rem;
    min-height: 2.75rem;
    border: 0.0625rem solid var(--color-border);
    border-radius: 0.5rem;
    background: var(--color-bg-soft);
    color: var(--color-text);
    font-size: 1.25rem;
  }
  input {
    box-sizing: border-box;
    display: block;
    width: 100%;
    padding: 0.875rem;
    border: 0.0625rem solid var(--color-border);
    border-radius: 0.5rem;
    background: var(--color-surface);
    color: var(--color-text);
    font: inherit;
    font-size: 0.875rem;
  }
  p {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin: 1rem 0;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .search :global(li a) {
    display: grid;
    gap: 0.375rem;
    padding: 1rem;
    border: 0.0625rem solid var(--color-border-soft);
    border-radius: 0.625rem;
    color: var(--color-text);
    text-decoration: none;
    font-size: 0.875rem;
    overflow-wrap: anywhere;
  }
  .search :global(li span) {
    font-size: 0.75rem;
    line-height: 1.7;
    color: var(--color-text-muted);
  }
  :focus-visible,
  .search :global(a:focus-visible) {
    outline: 0.125rem solid var(--color-accent);
    outline-offset: 0.1875rem;
  }
  @media (hover: hover) {
    .open:hover,
    .search :global(li a:hover) {
      background: var(--color-accent-soft);
    }
  }
  @media (width < 48rem) {
    .label,
    kbd {
      display: none;
    }
    .open {
      width: 2.75rem;
      height: 2.75rem;
      justify-content: center;
      font-size: 1.5rem;
    }
    .open::after {
      content: '';
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .open {
      transition: none;
    }
  }
</style>
