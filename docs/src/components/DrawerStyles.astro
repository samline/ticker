---
import drawerCss from '@samline/drawer/styles.css?inline'
interface Props {
  scope: 'ticker-docs-menu' | 'ticker-docs-search'
}
const { scope } = Astro.props
// The package owns motion. Adapt only its fixed lengths and stylesheet boundary.
const styles = drawerCss.replace(/(\d*\.?\d+)px\b/g, (_, length) => `${Number(length) / 16}rem`)
---

<style is:inline set:html={`@scope (${scope}) { ${styles} }`} />
