---
import Navigation from './Navigation.astro'
import { t } from '../i18n/en'
import drawerCss from '@samline/drawer/styles.css?inline'
interface Props {
  current: string
}
const { current } = Astro.props
const id = `docs-menu-${crypto.randomUUID()}`
const styles = drawerCss.replace(/(\d*\.?\d+)px\b/g, (_, length) => `${Number(length) / 16}rem`)
---

<ticker-docs-menu
  class:list={['mobile']}
  data-id={id}
  data-label={t.navigation}
  data-close={t.close}
>
  <button type="button" hidden aria-label={t.menu} aria-expanded="false" aria-haspopup="dialog">
    ☰
  </button>
  <details>
    <summary>{t.menu}</summary>
    <div class:list={['content']} data-content data-drawer-no-drag>
      <p class:list={['eyebrow']}>{t.name}</p>
      <h2>{t.docs}</h2>
      <Navigation current={current} />
    </div>
  </details>
</ticker-docs-menu>
<script>
  import { browser } from '@samline/drawer/browser'
  class DocsMenu extends HTMLElement {
    private lifecycle?: AbortController
    connectedCallback() {
      this.lifecycle?.abort()
      const button = this.querySelector('button'),
        fallback = this.querySelector('details'),
        content = this.querySelector('[data-content]'),
        id = this.dataset.id
      if (!button || !fallback || !content || !id) return
      this.lifecycle = new AbortController()
      const { signal } = this.lifecycle
      const drawer = browser.newDrawer({
        id,
        html: content.outerHTML,
        options: {
          container: this,
          triggerElement: button,
          direction: 'left',
          autoFocus: true,
          ariaLabel: this.dataset.label,
          contentClassName: 'docs-menu-panel',
          overlayClassName: 'docs-menu-overlay',
          closeButton: { icon: '×', ariaLabel: this.dataset.close, className: 'docs-menu-close' },
          onOpenChange: (open) => button.setAttribute('aria-expanded', String(open)),
        },
      })
      this.addEventListener(
        'click',
        (event) => {
          if (event.target instanceof Element && event.target.closest('.docs-menu-panel a'))
            drawer?.setOpen(false)
        },
        { signal }
      )
      matchMedia('(width >= 64rem)').addEventListener(
        'change',
        (event) => {
          if (event.matches) drawer?.setOpen(false)
        },
        { signal }
      )
      button.hidden = false
      fallback.hidden = true
    }
    disconnectedCallback() {
      this.lifecycle?.abort()
      if (this.dataset.id) browser.destroyDrawer(this.dataset.id)
    }
  }
  if (!customElements.get('ticker-docs-menu')) customElements.define('ticker-docs-menu', DocsMenu)
</script>
<style is:inline set:html={`@scope (ticker-docs-menu) { ${styles} }`} />
<style>
  .mobile {
    display: block;
  }
  [hidden] {
    display: none !important;
  }
  button,
  summary,
  .mobile :global(.docs-menu-close) {
    display: grid;
    place-items: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0.5rem;
    border: 0.0625rem solid var(--color-border);
    border-radius: 0.625rem;
    background: var(--color-bg-soft);
    color: var(--color-text);
    cursor: pointer;
    font-size: 1.25rem;
  }
  summary {
    font-size: 0.75rem;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  details {
    position: relative;
  }
  details > .content {
    position: absolute;
    left: 0;
    top: 3.25rem;
    width: min(20rem, calc(100vw - 2.5rem));
    max-height: calc(100dvh - 8rem);
    overflow: auto;
    padding: 1.25rem;
    background: var(--color-bg);
    border: 0.0625rem solid var(--color-border);
    border-radius: 0.75rem;
  }
  h2 {
    margin: 0.5rem 0 2rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 2.25rem;
    font-weight: 400;
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-accent);
    padding-right: 2.5rem;
  }
  .mobile :global(.docs-menu-panel) {
    position: fixed;
    inset: 0 auto 0 0;
    z-index: 101;
    width: min(22rem, calc(100% - 1rem));
    height: 100dvh;
    padding: 1.5rem;
    overflow: auto;
    overscroll-behavior: contain;
    background: var(--color-bg);
    color: var(--color-text);
    border-right: 0.0625rem solid var(--color-border);
  }
  .mobile :global(.docs-menu-overlay) {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: rgb(0 0 0 / 0.5);
  }
  .mobile :global(.docs-menu-close) {
    position: absolute;
    right: 1rem;
    top: 1rem;
  }
  button,
  summary,
  .mobile :global(.docs-menu-close) {
    transition:
      color var(--duration-ui) var(--ease-ui),
      background-color var(--duration-ui) var(--ease-ui);
  }
  @media (hover: hover) {
    button:hover,
    summary:hover,
    .mobile :global(.docs-menu-close:hover) {
      color: var(--color-accent);
      background: var(--color-accent-soft);
    }
  }
  :focus-visible,
  .mobile :global(.docs-menu-close:focus-visible) {
    outline: 0.125rem solid var(--color-accent);
    outline-offset: 0.1875rem;
  }
  @media (width >= 64rem) {
    .mobile {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    button,
    summary,
    .mobile :global(.docs-menu-close) {
      transition: none;
    }
    .mobile :global(.docs-menu-panel),
    .mobile :global(.docs-menu-overlay) {
      animation: none !important;
      transition: none !important;
    }
  }
</style>
